  "tests": [
    {
      "description": "hash a message through BearSSL's streaming SHA-256 API",
      "steps": [
        {
          "type": "function.invoke",
          "function": "_initialize",
          "params": [],
          "results": []
        },
        {
          "type": "function.invoke",
          "description": "allocate 256 bytes",
          "function": "malloc",
          "params": [
            {
              "type": "i32",
              "value": "256"
            }
          ],
          "results": [
            {
              "type": "i32",
              "capture": "ctx"
            }
          ]
        },
        {
          "type": "function.invoke",
          "description": "allocate 3 bytes",
          "function": "malloc",
          "params": [
            {
              "type": "i32",
              "value": "3"
            }
          ],
          "results": [
            {
              "type": "i32",
              "capture": "input"
            }
          ]
        },
        {
          "type": "function.invoke",
          "description": "allocate 32 bytes",
          "function": "malloc",
          "params": [
            {
              "type": "i32",
              "value": "32"
            }
          ],
          "results": [
            {
              "type": "i32",
              "capture": "digest"
            }
          ]
        },
        {
          "type": "memory.write",
          "memory": "memory",
          "offset": {
            "var": "input"
          },
          "bytes": {
            "encoding": "utf8",
            "value": "abc"
          }
        },
        {
          "type": "function.invoke",
          "function": "br_sha256_init",
          "params": [
            {
              "type": "i32",
              "var": "ctx"
            }
          ],
          "results": []
        },
        {
          "type": "function.invoke",
          "function": "br_sha224_update",
          "params": [
            {
              "type": "i32",
              "var": "ctx"
            },
            {
              "type": "i32",
              "var": "input"
            },
            {
              "type": "i32",
              "value": "3"
            }
          ],
          "results": []
        },
        {
          "type": "function.invoke",
          "function": "br_sha256_out",
          "params": [
            {
              "type": "i32",
              "var": "ctx"
            },
            {
              "type": "i32",
              "var": "digest"
            }
          ],
          "results": []
        },
        {
          "type": "memory.read",
          "description": "assert the standard SHA-256 abc vector",
          "memory": "memory",
          "offset": {
            "var": "digest"
          },
          "assert": {
            "type": "bytes",
            "bytes": {
              "encoding": "hex",
              "value": "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
            }
          }
        }
      ]
    }

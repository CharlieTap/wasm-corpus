      "kind": "function",
      "type": "(func (param i32) (result i32))"
    },
    {
      "name": "calc_sha_256",
      "kind": "function",
      "type": "(func (param i32 i32 i32))"
    }
  ],
  "tests": [
    {
      "description": "calculate the SHA-256 abc test vector",
      "steps": [
        {
          "type": "function.invoke",
          "function": "_initialize",
          "params": [],
          "results": []
        },
        {
          "type": "function.invoke",
          "description": "allocate 3 bytes",
          "function": "malloc",
          "params": [
            {
              "type": "i32",
              "value": "3"
            }
          ],
          "results": [
            {
              "type": "i32",
              "capture": "input"
            }
          ]
        },
        {
          "type": "function.invoke",
          "description": "allocate 32 bytes",
          "function": "malloc",
          "params": [
            {
              "type": "i32",
              "value": "32"
            }
          ],
          "results": [
            {
              "type": "i32",
              "capture": "digest"
            }
          ]
        },
        {
          "type": "memory.write",
          "memory": "memory",
          "offset": {
            "var": "input"
          },
          "bytes": {
            "encoding": "utf8",
            "value": "abc"
          }
        },
        {
          "type": "function.invoke",
          "function": "calc_sha_256",
          "params": [
            {
              "type": "i32",
              "var": "digest"
            },
            {
              "type": "i32",
              "var": "input"
            },
            {
              "type": "i32",
              "value": "3"
            }
          ],
          "results": []
        },
        {
          "type": "memory.read",
          "memory": "memory",
          "offset": {
            "var": "digest"
          },
          "assert": {
            "type": "bytes",
            "bytes": {
              "encoding": "hex",
              "value": "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"
            }
          }
        }
      ]
    }
  ],

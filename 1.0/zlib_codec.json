  "tests": [
    {
      "description": "compress and decompress a text buffer with zlib",
      "steps": [
        {
          "type": "function.invoke",
          "function": "_initialize",
          "params": [],
          "results": []
        },
        {
          "type": "function.invoke",
          "description": "allocate 55 bytes",
          "function": "malloc",
          "params": [
            {
              "type": "i32",
              "value": "55"
            }
          ],
          "results": [
            {
              "type": "i32",
              "capture": "input"
            }
          ]
        },
        {
          "type": "function.invoke",
          "description": "allocate 256 bytes",
          "function": "malloc",
          "params": [
            {
              "type": "i32",
              "value": "256"
            }
          ],
          "results": [
            {
              "type": "i32",
              "capture": "compressed"
            }
          ]
        },
        {
          "type": "function.invoke",
          "description": "allocate 4 bytes",
          "function": "malloc",
          "params": [
            {
              "type": "i32",
              "value": "4"
            }
          ],
          "results": [
            {
              "type": "i32",
              "capture": "compressed_len_ptr"
            }
          ]
        },
        {
          "type": "function.invoke",
          "description": "allocate 256 bytes",
          "function": "malloc",
          "params": [
            {
              "type": "i32",
              "value": "256"
            }
          ],
          "results": [
            {
              "type": "i32",
              "capture": "restored"
            }
          ]
        },
        {
          "type": "function.invoke",
          "description": "allocate 4 bytes",
          "function": "malloc",
          "params": [
            {
              "type": "i32",
              "value": "4"
            }
          ],
          "results": [
            {
              "type": "i32",
              "capture": "restored_len_ptr"
            }
          ]
        },
        {
          "type": "memory.write",
          "memory": "memory",
          "offset": {
            "var": "input"
          },
          "bytes": {
            "encoding": "utf8",
            "value": "WebAssembly corpus compression compression compression!"
          }
        },
        {
          "type": "memory.write",
          "memory": "memory",
          "offset": {
            "var": "compressed_len_ptr"
          },
          "value": {
            "type": "i32",
            "value": "256"
          }
        },
        {
          "type": "memory.write",
          "memory": "memory",
          "offset": {
            "var": "restored_len_ptr"
          },
          "value": {
            "type": "i32",
            "value": "55"
          }
        },
        {
          "type": "function.invoke",
          "function": "compress2",
          "params": [
            {
              "type": "i32",
              "var": "compressed"
            },
            {
              "type": "i32",
              "var": "compressed_len_ptr"
            },
            {
              "type": "i32",
              "var": "input"
            },
            {
              "type": "i32",
              "value": "55"
            },
            {
              "type": "i32",
              "value": "9"
            }
          ],
          "results": [
            {
              "type": "i32",
              "value": "0"
            }
          ]
        },
        {
          "type": "memory.read",
          "memory": "memory",
          "offset": {
            "var": "compressed_len_ptr"
          },
          "capture": {
            "type": "i32",
            "capture": "compressed_len"
          }
        },
        {
          "type": "function.invoke",
          "function": "uncompress",
          "params": [
            {
              "type": "i32",
              "var": "restored"
            },
            {
              "type": "i32",
              "var": "restored_len_ptr"
            },
            {
              "type": "i32",
              "var": "compressed"
            },
            {
              "type": "i32",
              "var": "compressed_len"
            }
          ],
          "results": [
            {
              "type": "i32",
              "value": "0"
            }
          ]
        },
        {
          "type": "memory.read",
          "memory": "memory",
          "offset": {
            "var": "restored_len_ptr"
          },
          "assert": {
            "type": "value",
            "value": {
              "type": "i32",
              "value": "55"
            }
          }
        },
        {
          "type": "memory.read",
          "memory": "memory",
          "offset": {
            "var": "restored"
          },
          "assert": {
            "type": "bytes",
            "bytes": {
              "encoding": "utf8",
              "value": "WebAssembly corpus compression compression compression!"
            }
          }
        }
      ]
    }
  ],

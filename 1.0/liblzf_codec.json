  ],
  "exports": [
    {
      "name": "memory",
      "kind": "memory",
      "type": "(memory 257)"
    },
    {
      "name": "_initialize",
      "kind": "function",
      "type": "(func)"
    },
    {
      "name": "malloc",
      "kind": "function",
      "type": "(func (param i32) (result i32))"
    },
    {
      "name": "free",
      "kind": "function",
      "type": "(func (param i32))"
    },
    {
      "name": "lzf_compress",
      "kind": "function",
      "type": "(func (param i32 i32 i32 i32) (result i32))"
    },
    {
      "name": "lzf_decompress",
      "kind": "function",
      "type": "(func (param i32 i32 i32 i32) (result i32))"
    }
  ],
  "tests": [
    {
      "description": "round-trip text with liblzf compression",
      "steps": [
        {
          "type": "function.invoke",
          "function": "_initialize",
          "params": [],
          "results": []
        },
        {
          "type": "function.invoke",
          "description": "allocate 55 bytes",
          "function": "malloc",
          "params": [
            {
              "type": "i32",
              "value": "55"
            }
          ],
          "results": [
            {
              "type": "i32",
              "capture": "input"
            }
          ]
        },
        {
          "type": "function.invoke",
          "description": "allocate 256 bytes",
          "function": "malloc",
          "params": [
            {
              "type": "i32",
              "value": "256"
            }
          ],
          "results": [
            {
              "type": "i32",
              "capture": "compressed"
            }
          ]
        },
        {
          "type": "function.invoke",
          "description": "allocate 256 bytes",
          "function": "malloc",
          "params": [
            {
              "type": "i32",
              "value": "256"
            }
          ],
          "results": [
            {
              "type": "i32",
              "capture": "restored"
            }
          ]
        },
        {
          "type": "memory.write",
          "memory": "memory",
          "offset": {
            "var": "input"
          },
          "bytes": {
            "encoding": "utf8",
            "value": "WebAssembly corpus compression compression compression!"
          }
        },
        {
          "type": "function.invoke",
          "function": "lzf_compress",
          "params": [
            {
              "type": "i32",
              "var": "input"
            },
            {
              "type": "i32",
              "value": "55"
            },
            {
              "type": "i32",
              "var": "compressed"
            },
            {
              "type": "i32",
              "value": "256"
            }
          ],
          "results": [
            {
              "type": "i32",
              "capture": "compressed_len"
            }
          ]
        },
        {
          "type": "function.invoke",
          "function": "lzf_decompress",
          "params": [
            {
              "type": "i32",
              "var": "compressed"
            },
            {
              "type": "i32",
              "var": "compressed_len"
            },
            {
              "type": "i32",
              "var": "restored"
            },
            {
              "type": "i32",
              "value": "256"
            }
          ],
          "results": [
            {
              "type": "i32",
              "value": "55"
            }
          ]
        },
        {
          "type": "memory.read",
          "memory": "memory",
          "offset": {
            "var": "restored"
          },
          "assert": {
            "type": "bytes",
            "bytes": {
              "encoding": "utf8",
              "value": "WebAssembly corpus compression compression compression!"
            }
          }
        }
      ]
    }
  ],
  "sha256": "f94da6e6b9aa15675d5bafb1a596dc4b0caf24e675b9b93d79baa602fb3a6532",

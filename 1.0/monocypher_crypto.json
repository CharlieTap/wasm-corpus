  "tests": [
    {
      "description": "calculate BLAKE2b with Monocypher",
      "steps": [
        {
          "type": "function.invoke",
          "function": "_initialize",
          "params": [],
          "results": []
        },
        {
          "type": "function.invoke",
          "description": "allocate 3 bytes",
          "function": "malloc",
          "params": [
            {
              "type": "i32",
              "value": "3"
            }
          ],
          "results": [
            {
              "type": "i32",
              "capture": "input"
            }
          ]
        },
        {
          "type": "function.invoke",
          "description": "allocate 64 bytes",
          "function": "malloc",
          "params": [
            {
              "type": "i32",
              "value": "64"
            }
          ],
          "results": [
            {
              "type": "i32",
              "capture": "digest"
            }
          ]
        },
        {
          "type": "memory.write",
          "memory": "memory",
          "offset": {
            "var": "input"
          },
          "bytes": {
            "encoding": "utf8",
            "value": "abc"
          }
        },
        {
          "type": "function.invoke",
          "function": "crypto_blake2b",
          "params": [
            {
              "type": "i32",
              "var": "digest"
            },
            {
              "type": "i32",
              "value": "64"
            },
            {
              "type": "i32",
              "var": "input"
            },
            {
              "type": "i32",
              "value": "3"
            }
          ],
          "results": []
        },
        {
          "type": "memory.read",
          "memory": "memory",
          "offset": {
            "var": "digest"
          },
          "assert": {
            "type": "bytes",
            "bytes": {
              "encoding": "hex",
              "value": "ba80a53f981c4d0d6a2797b69f12f6e94c212f14685ac4b74b12bb6fdbffa2d17d87c5392aab792dc252d5de4533cc9518d38aa8dbf1925ab92386edd4009923"
            }
          }
        }
      ]
    },

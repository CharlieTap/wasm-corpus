  "tests": [
    {
      "description": "construct and concatenate an SDS dynamic string",
      "steps": [
        {
          "type": "function.invoke",
          "function": "_initialize",
          "params": [],
          "results": []
        },
        {
          "type": "function.invoke",
          "description": "allocate 13 bytes",
          "function": "malloc",
          "params": [
            {
              "type": "i32",
              "value": "13"
            }
          ],
          "results": [
            {
              "type": "i32",
              "capture": "first"
            }
          ]
        },
        {
          "type": "function.invoke",
          "description": "allocate 8 bytes",
          "function": "malloc",
          "params": [
            {
              "type": "i32",
              "value": "8"
            }
          ],
          "results": [
            {
              "type": "i32",
              "capture": "second"
            }
          ]
        },
        {
          "type": "memory.write",
          "memory": "memory",
          "offset": {
            "var": "first"
          },
          "bytes": {
            "encoding": "utf8",
            "value": "WebAssembly\u0000"
          }
        },
        {
          "type": "memory.write",
          "memory": "memory",
          "offset": {
            "var": "second"
          },
          "bytes": {
            "encoding": "utf8",
            "value": " corpus\u0000"
          }
        },
        {
          "type": "function.invoke",
          "function": "sdsnew",
          "params": [
            {
              "type": "i32",
              "var": "first"
            }
          ],
          "results": [
            {
              "type": "i32",
              "capture": "sds"
            }
          ]
        },
        {
          "type": "function.invoke",
          "function": "sdscat",
          "params": [
            {
              "type": "i32",
              "var": "sds"
            },
            {
              "type": "i32",
              "var": "second"
            }
          ],
          "results": [
            {
              "type": "i32",
              "capture": "joined"
            }
          ]
        },
        {
          "type": "memory.read",
          "memory": "memory",
          "offset": {
            "var": "joined"
          },
          "assert": {
            "type": "bytes",
            "bytes": {
              "encoding": "utf8",
              "value": "WebAssembly corpus"
            }
          }
        },
        {
          "type": "function.invoke",
          "function": "sdsfree",
          "params": [
            {
              "type": "i32",
              "var": "joined"
            }
          ],
          "results": []
        }
      ]
    }
  ],

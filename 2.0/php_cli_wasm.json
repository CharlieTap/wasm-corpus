      "description": "exercise Reflection, SPL priority queues, and tokenization",
      "host": {
        "emscripten_php_cli": {
          "glue": "php_cli_wasm.mjs",
          "command_args": [
            "php",
            "-c",
            "/php.ini",
            "-r",
            "class Box { public function inc(int $x): int { return $x + 1; } } $m=new ReflectionMethod(Box::class,\"inc\"); echo \"return=\".$m->getReturnType().\",params=\".count($m->getParameters()).\"\\n\"; $h=new SplPriorityQueue(); foreach([[\"low\",1],[\"high\",10],[\"mid\",5]] as $x) $h->insert($x[0],$x[1]); foreach($h as $v) echo \"heap=\".$v.\"\\n\"; $code='<?php function f($x){ return $x*2; }'; $names=[]; foreach(token_get_all($code) as $tok) if(is_array($tok)) $names[]=token_name($tok[0]); echo \"tokens=\".implode(\",\",array_slice($names,0,6)).\"\\n\";"
          ]
        }
      },

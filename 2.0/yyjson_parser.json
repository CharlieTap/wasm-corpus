{
  "$schema": "../schema/fixture.schema.json",
  "name": "yyjson_parser",
  "path": "yyjson_parser.wasm",
  "wat": {
    "status": "present",
    "path": "yyjson_parser.wat"
  },
  "features": [
    "bulk-memory",
    "sign-extensions"
  ],
  "tags": [
    "domain-parsing",
    "domain-serialization",
    "duration-short",
    "size-large"
  ],
  "exports": [
    {
      "name": "memory",
      "kind": "memory",
      "type": "(memory 257)"
    },
    {
      "name": "_initialize",
      "kind": "function",
      "type": "(func)"
    },
    {
      "name": "malloc",
      "kind": "function",
      "type": "(func (param i32) (result i32))"
    },
    {
      "name": "free",
      "kind": "function",
      "type": "(func (param i32))"
    },
    {
      "name": "yyjson_mut_doc_free",
      "kind": "function",
      "type": "(func (param i32))"
    },
    {
      "name": "yyjson_mut_doc_new",
      "kind": "function",
      "type": "(func (param i32) (result i32))"
    },
    {
      "name": "yyjson_read_opts",
      "kind": "function",
      "type": "(func (param i32 i32 i32 i32 i32) (result i32))"
    },
    {
      "name": "yyjson_write_opts",
      "kind": "function",
      "type": "(func (param i32 i32 i32 i32 i32) (result i32))"
    }
  ],
  "tests": [
    {
      "description": "parse and serialize JSON through yyjson",
      "steps": [
        {
          "type": "function.invoke",
          "function": "_initialize",
          "params": [],
          "results": []
        },
        {
          "type": "function.invoke",
          "description": "allocate 48 bytes",
          "function": "malloc",
          "params": [
            {
              "type": "i32",
              "value": "48"
            }
          ],
          "results": [
            {
              "type": "i32",
              "capture": "json"
            }
          ]
        },
        {
          "type": "function.invoke",
          "description": "allocate 4 bytes",
          "function": "malloc",
          "params": [
            {
              "type": "i32",
              "value": "4"
            }
          ],
          "results": [
            {
              "type": "i32",
              "capture": "output_len"
            }
          ]
        },
        {
          "type": "memory.write",
          "memory": "memory",
          "offset": {
            "var": "json"
          },
          "bytes": {
            "encoding": "utf8",
            "value": "{\"items\":[1,2,3],\"ok\":true}"
          }
        },
        {
          "type": "function.invoke",
          "function": "yyjson_read_opts",
          "params": [
            {
              "type": "i32",
              "var": "json"
            },
            {
              "type": "i32",
              "value": "27"
            },
            {
              "type": "i32",
              "value": "0"
            },
            {
              "type": "i32",
              "value": "0"
            },
            {
              "type": "i32",
              "value": "0"
            }
          ],
          "results": [
            {
              "type": "i32",
              "capture": "doc"
            }
          ]
        },
        {
          "type": "function.invoke",
          "function": "yyjson_write_opts",
          "params": [
            {
              "type": "i32",
              "var": "doc"
            },
            {
              "type": "i32",
              "value": "0"
            },
            {
              "type": "i32",
              "value": "0"
            },
            {
              "type": "i32",
              "var": "output_len"
            },
            {
              "type": "i32",
              "value": "0"
            }
          ],
          "results": [
            {
              "type": "i32",
              "capture": "output"
            }
          ]
        },
        {
          "type": "memory.read",
          "memory": "memory",
          "offset": {
            "var": "output_len"
          },
          "assert": {
            "type": "value",
            "value": {
              "type": "i32",
              "value": "27"
            }
          }
        },
        {
          "type": "memory.read",
          "memory": "memory",
          "offset": {
            "var": "output"
          },
          "assert": {
            "type": "bytes",
            "bytes": {
              "encoding": "utf8",
              "value": "{\"items\":[1,2,3],\"ok\":true}"
            }
          }
        }
      ]
    }
  ],
  "sha256": "fa8d68e7c0c06fddfa7a8c86250d7063642599c6710c0430ed16122cf6d0a1b4",
  "source": {
    "contributor": "human",
    "language": "c",
    "path": "src/yyjson.c",
    "url": "https://github.com/ibireme/yyjson/blob/757305bfaf4b8cb3e52c105926dc9105fb785101/src/yyjson.c",
    "description": "yyjson high-performance JSON parser and writer. Compiled from the upstream project's human-authored source at commit 757305bfaf4b8cb3e52c105926dc9105fb785101."
  },
  "toolchain": {
    "name": "Zig/LLVM",
    "version": "zig 0.16.0; wasm-opt version 131",
    "command": "zig cc -target wasm32-wasi -O2 -g0 src/yyjson.c ...; ./scripts/prepare"
  },
  "description": "yyjson high-performance JSON parser and writer.",
  "notes": "The fixture contains no generated workload or wrapper program: it is the upstream command/test source or library implementation itself. The metadata test drives the project's public API with representative data. Build-only configuration selects WASI-compatible facilities and does not replace project behavior."

  "tests": [
    {
      "description": "extract a nested number and decoded string from JSON",
      "steps": [
        {
          "type": "function.invoke",
          "function": "_initialize",
          "params": [],
          "results": []
        },
        {
          "type": "function.invoke",
          "description": "allocate 48 bytes",
          "function": "malloc",
          "params": [
            {
              "type": "i32",
              "value": "48"
            }
          ],
          "results": [
            {
              "type": "i32",
              "capture": "json"
            }
          ]
        },
        {
          "type": "function.invoke",
          "description": "allocate 16 bytes",
          "function": "malloc",
          "params": [
            {
              "type": "i32",
              "value": "16"
            }
          ],
          "results": [
            {
              "type": "i32",
              "capture": "path_num"
            }
          ]
        },
        {
          "type": "function.invoke",
          "description": "allocate 16 bytes",
          "function": "malloc",
          "params": [
            {
              "type": "i32",
              "value": "16"
            }
          ],
          "results": [
            {
              "type": "i32",
              "capture": "path_str"
            }
          ]
        },
        {
          "type": "function.invoke",
          "description": "allocate 8 bytes",
          "function": "malloc",
          "params": [
            {
              "type": "i32",
              "value": "8"
            }
          ],
          "results": [
            {
              "type": "i32",
              "capture": "number"
            }
          ]
        },
        {
          "type": "function.invoke",
          "description": "allocate 32 bytes",
          "function": "malloc",
          "params": [
            {
              "type": "i32",
              "value": "32"
            }
          ],
          "results": [
            {
              "type": "i32",
              "capture": "text"
            }
          ]
        },
        {
          "type": "memory.write",
          "memory": "memory",
          "offset": {
            "var": "json"
          },
          "bytes": {
            "encoding": "utf8",
            "value": "{\"metrics\":{\"value\":1200},\"name\":\"wasm\"}\u0000"
          }
        },
        {
          "type": "memory.write",
          "memory": "memory",
          "offset": {
            "var": "path_num"
          },
          "bytes": {
            "encoding": "utf8",
            "value": "$.metrics.value\u0000"
          }
        },
        {
          "type": "memory.write",
          "memory": "memory",
          "offset": {
            "var": "path_str"
          },
          "bytes": {
            "encoding": "utf8",
            "value": "$.name\u0000"
          }
        },
        {
          "type": "function.invoke",
          "function": "mjson_get_number",
          "params": [
            {
              "type": "i32",
              "var": "json"
            },
            {
              "type": "i32",
              "value": "45"
            },
            {
              "type": "i32",
              "var": "path_num"
            },
            {
              "type": "i32",
              "var": "number"
            }
          ],
          "results": [
            {
              "type": "i32",
              "value": "1"
            }
          ]
        },
        {
          "type": "memory.read",
          "memory": "memory",
          "offset": {
            "var": "number"
          },
          "assert": {
            "type": "value",
            "value": {
              "type": "f64",
              "value": "4652992471259676672"
            }
          }
        },
        {
          "type": "function.invoke",
          "function": "mjson_get_string",
          "params": [
            {
              "type": "i32",
              "var": "json"
            },
            {
              "type": "i32",
              "value": "45"
            },
            {
              "type": "i32",
              "var": "path_str"
            },
            {
              "type": "i32",
              "var": "text"
            },
            {
              "type": "i32",
              "value": "32"
            }
          ],
          "results": [
            {
              "type": "i32",
              "value": "4"
            }
          ]
        },
        {
          "type": "memory.read",
          "memory": "memory",
          "offset": {
            "var": "text"
          },
          "assert": {
            "type": "bytes",
            "bytes": {
              "encoding": "utf8",
              "value": "wasm"
            }
          }
        }
      ]
    }

  (data (;7755;) "\1a\9d\8b\a7\12\22\01\18function.mjs\01\0cresult\01\06foo\01\12readInput\01\16writeOutput\01\02n\01\06bar\01\02!\01\0cnewBar\01\12chunkSize\01\16inputChunks\01\14totalBytes\01\0cbuffer\01\04fd\01\12bytesRead\01\16finalBuffer\01\0econtext\01\0achunk\01\18bufferOffset\01\08Javy\01\04IO\01\10readSync\01\08push\01\10subarray\01\0creduce\01\0aparse\01\16TextDecoder\01\0cdecode\01\0coutput\01\1aencodedOutput\01\16TextEncoder\01\0cencode\01\12stringify\01\12writeSync\0d\e4\03\00\00\00\00\00\0c \0a\01\a8\01\00\00\00\02\00\05\03\22\00\c0\01\00\1e\e6\03\01\1e\e8\03\02\06\ea\03\03\06\ec\03\04\06\0cC\0a\01\e8\03\01\00\01\03\00\00\00 \01\c0\01\00\01\00\0b\d7@\f7\00\00\00\bb\9cK\f4\00\00\00\d7@\f8\00\00\00\04\f9\00\00\00\9cK\fa\00\00\00(\e4\03\09\01\04&8C.Qfunction foo(input) {\0a    return { foo: input.n + 1, newBar: input.bar + \22!\22 };\0a}\0cC\0a\01\ea\03\00\07\00\07\00\00\01\d2\01\07\f6\03\01\000\f8\03\01\010\fa\03\01\02 \fc\03\02\070\fe\03\02\040\80\04\02\050\82\04\01\030\0cB\0a\01\00\02\00\02\04\00\00\00&\02\84\04\00\01\00\86\04\00\01\00\d7@\01\01\00\00AF\00\00\00\d8\d7@\04\01\00\00$\02\00\0e\d7A\04\01\00\00\d8\ef\9cB\04\01\00\00\d7(\e4\03\22)\06\03?90:/\9f\01(context, chunk) => {\0a        context.finalBuffer.set(chunk, context.bufferOffset);\0a        context.bufferOffset += chunk.length;\0a        return context;\0a    }`\06\00`\02\00`\01\00`\00\00\c3\00\04\cf&\00\00\d0\ba\d1`\05\00`\04\00`\03\008\b1\00\00\00\11a\00\00!\01\00\d2\ba\c8\048\05\01\00\00@\06\01\00\00A\07\01\00\00a\04\00a\03\00$\02\00\c8\05a\02\00a\05\00\9c\11b\02\00\0ea\05\00\ba\ad\f1\1ea\01\00A\08\01\00\00a\03\00A\09\01\00\00\baa\05\00$\02\00$\01\00\0e\f2\9e\06\11\f8\f1\0cpA\01\01\00\00\c8\06\0e\f2)\0ea\01\00A\0a\01\00\00\c5\00\0b\baK\04\01\00\008\b1\00\00\00\11a\02\00!\01\00K\01\01\00\00$\02\00\f2\ce8\a7\00\00\00A\0b\01\00\008\0c\01\00\00\11!\00\00A\0d\01\00\00a\06\00$\01\00%\01\00\e4\03\0e\01\1c\00\1f\0e6\a0 ;EN$\19#*\22*\0e\00&\08\10\00\09\08\06\a4!H*\dc\06function readInput() {\0a    const chunkSize = 1024;\0a    const inputChunks = [];\0a    let totalBytes = 0;\0a\0a    // Read all the available bytes\0a    while (true) {\0a        const buffer = new Uint8Array(chunkSize);\0a        // Stdin file descriptor\0a        const fd = 0;\0a        const bytesRead = Javy.IO.readSync(fd, buffer);\0a\0a        totalBytes += bytesRead;\0a        if (bytesRead === 0) {\0a            break;\0a        }\0a        inputChunks.push(buffer.subarray(0, bytesRead));\0a    }\0a\0a    // Assemble input into a single Uint8Array\0a    const { finalBuffer } = inputChunks.reduce((context, chunk) => {\0a        context.finalBuffer.set(chunk, context.bufferOffset);\0a        context.bufferOffset += chunk.length;\0a        return context;\0a    }, { bufferOffset: 0, finalBuffer: new Uint8Array(totalBytes) });\0a\0a    return JSON.parse(new TextDecoder().decode(finalBuffer));\0a}\0cC\0a\01\ec\03\01\03\01\05\00\00\00Q\04\9c\04\00\01\00\9e\04\01\000\fc\03\01\010\fe\03\01\020`\02\00`\01\00`\00\008\10\01\00\00\11!\00\00A\11\01\00\008\a7\00\00\00A\12\01\00\00\d7$\01\00$\01\00\cf8\b1\00\00\00\11a\00\00!\01\00\d0\bb\d18\05\01\00\00@\06\01\00\00A\13\01\00\00a\02\00a\01\00$\02\00)\e4\03,\01\0c0<H*4\1e+UP%M$\f1\01function writeOutput(output) {\0a    const encodedOutput = new TextEncoder().encode(JSON.stringify(output));\0a    const buffer = new Uint8Array(encodedOutput);\0a    // Stdout file descriptor\0a    const fd = 1;\0a    Javy.IO.writeSync(fd, buffer);\0a}\08\f0\0d\c5\00\e9\c5\01\ea\c5\02^\04\00)\e6\f4\e7\e5d\00\00\f5\e8]\04\00d\01\00\f5\0e\06/\e4\03\01\01\08S\1c\13\0a\1d%\11\18\00")

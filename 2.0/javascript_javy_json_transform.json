  "tests": [
    {
      "description": "parse, transform, and serialize a JSON object",
      "host": {
        "wasi_preview_1": {
          "command_args": [
            "javascript_javy_json_transform"
          ],
          "system_env": {},
          "preopened_directories": {},
          "stdin": {
            "encoding": "utf8",
            "value": "{\"n\":2,\"bar\":\"baz\"}"
          }
        }
      },
      "steps": [
        {
          "type": "function.invoke",
          "description": "run the bundled JavaScript through Javy's QuickJS runtime",
          "function": "_start",
          "params": [],
          "results": [],
          "host_effects": {
            "exit_code": 0,
            "stdout": {
              "type": "bytes",
              "bytes": {
                "encoding": "utf8",
                "value": "{\"foo\":3,\"newBar\":\"baz!\"}"
              }
            },
            "stderr": {
              "type": "bytes",
              "bytes": {
                "encoding": "utf8",
                "value": ""
              }
            }
          }
        }
      ],
      "notes": "Exercises stdin reads, typed-array chunk collection, UTF-8 decoding, JSON parsing, numeric addition, string concatenation, JSON serialization, UTF-8 encoding, and stdout writes."
    },

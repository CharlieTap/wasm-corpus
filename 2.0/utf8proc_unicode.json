  "tests": [
    {
      "description": "case-fold and compose Unicode text",
      "steps": [
        {
          "type": "function.invoke",
          "function": "_initialize",
          "params": [],
          "results": []
        },
        {
          "type": "function.invoke",
          "description": "allocate 16 bytes",
          "function": "malloc",
          "params": [
            {
              "type": "i32",
              "value": "16"
            }
          ],
          "results": [
            {
              "type": "i32",
              "capture": "input"
            }
          ]
        },
        {
          "type": "function.invoke",
          "description": "allocate 4 bytes",
          "function": "malloc",
          "params": [
            {
              "type": "i32",
              "value": "4"
            }
          ],
          "results": [
            {
              "type": "i32",
              "capture": "output_ptr"
            }
          ]
        },
        {
          "type": "memory.write",
          "memory": "memory",
          "offset": {
            "var": "input"
          },
          "bytes": {
            "encoding": "utf8",
            "value": "Straße\u0000"
          }
        },
        {
          "type": "function.invoke",
          "function": "utf8proc_map",
          "params": [
            {
              "type": "i32",
              "var": "input"
            },
            {
              "type": "i32",
              "value": "7"
            },
            {
              "type": "i32",
              "var": "output_ptr"
            },
            {
              "type": "i32",
              "value": "1033"
            }
          ],
          "results": [
            {
              "type": "i32",
              "value": "7"
            }
          ]
        },
        {
          "type": "memory.read",
          "memory": "memory",
          "offset": {
            "var": "output_ptr"
          },
          "capture": {
            "type": "i32",
            "capture": "output"
          }
        },
        {
          "type": "memory.read",
          "memory": "memory",
          "offset": {
            "var": "output"
          },
          "assert": {
            "type": "bytes",
            "bytes": {
              "encoding": "utf8",
              "value": "strasse"
            }
          }
        },
        {
          "type": "function.invoke",
          "function": "free",
          "params": [
            {
              "type": "i32",
              "var": "output"
            }
          ],
          "results": []
        }
      ]
    }
  ],

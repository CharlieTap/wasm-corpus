  "tests": [
    {
      "description": "parse and serialize a nested Parson JSON document",
      "steps": [
        {
          "type": "function.invoke",
          "function": "_initialize",
          "params": [],
          "results": []
        },
        {
          "type": "function.invoke",
          "description": "allocate 64 bytes",
          "function": "malloc",
          "params": [
            {
              "type": "i32",
              "value": "64"
            }
          ],
          "results": [
            {
              "type": "i32",
              "capture": "json"
            }
          ]
        },
        {
          "type": "memory.write",
          "memory": "memory",
          "offset": {
            "var": "json"
          },
          "bytes": {
            "encoding": "utf8",
            "value": "{\"project\":\"wasm-corpus\",\"values\":[1,2,3]}\u0000"
          }
        },
        {
          "type": "function.invoke",
          "function": "json_parse_string",
          "params": [
            {
              "type": "i32",
              "var": "json"
            }
          ],
          "results": [
            {
              "type": "i32",
              "capture": "value"
            }
          ]
        },
        {
          "type": "function.invoke",
          "function": "json_serialize_to_string",
          "params": [
            {
              "type": "i32",
              "var": "value"
            }
          ],
          "results": [
            {
              "type": "i32",
              "capture": "serialized"
            }
          ]
        },
        {
          "type": "memory.read",
          "memory": "memory",
          "offset": {
            "var": "serialized"
          },
          "assert": {
            "type": "bytes",
            "bytes": {
              "encoding": "utf8",
              "value": "{\"project\":\"wasm-corpus\",\"values\":[1,2,3]}"
            }
          }
        },
        {
          "type": "function.invoke",
          "function": "json_free_serialized_string",
          "params": [
            {
              "type": "i32",
              "var": "serialized"
            }
          ],
          "results": []
        },
        {
          "type": "function.invoke",
          "function": "json_value_free",
          "params": [
            {
              "type": "i32",
              "var": "value"
            }
          ],
          "results": []
        }
      ]
    }
  ],

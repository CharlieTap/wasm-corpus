{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/CharlieTap/wasm-corpus/main/schema/fixture.schema.json",
  "title": "wasm-corpus fixture metadata",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "path",
    "wat",
    "features",
    "tests",
    "sha256",
    "source",
    "tags"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]*$"
    },
    "path": {
      "type": "string",
      "pattern": "^[^/].*\\.wasm$"
    },
    "wat": {
      "$ref": "#/$defs/wat"
    },
    "description": {
      "type": "string"
    },
    "features": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/feature"
      },
      "uniqueItems": true
    },
    "imports": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/import"
      }
    },
    "exports": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/export"
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/test"
      },
      "minItems": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "toolchain": {
      "$ref": "#/$defs/toolchain"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]*$"
      },
      "uniqueItems": true
    },
    "notes": {
      "type": "string"
    }
  },
  "$defs": {
    "wat": {
      "oneOf": [
        {
          "$ref": "#/$defs/presentWat"
        },
        {
          "$ref": "#/$defs/tooLargeWat"
        }
      ]
    },
    "presentWat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "path"
      ],
      "properties": {
        "status": {
          "const": "present"
        },
        "path": {
          "type": "string",
          "pattern": "^[^/].*\\.wat$"
        }
      }
    },
    "tooLargeWat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "generated_size",
        "limit",
        "tool"
      ],
      "properties": {
        "status": {
          "const": "too_large_for_corpus"
        },
        "generated_size": {
          "type": "integer",
          "minimum": 1
        },
        "limit": {
          "type": "integer",
          "minimum": 1
        },
        "tool": {
          "type": "string"
        }
      }
    },
    "feature": {
      "type": "string",
      "enum": [
        "big-int",
        "branch-hinting",
        "bulk-memory",
        "compact-import-section",
        "compilation-hints",
        "component-model",
        "custom-annotation-syntax-in-the-text-format",
        "custom-descriptors",
        "custom-page-sizes",
        "esm-integration",
        "exception-handling",
        "extended-const",
        "extended-name-section",
        "flexible-vectors",
        "frozen-values",
        "gc",
        "half-precision",
        "jit-interface",
        "js-primitive-builtins",
        "js-string-builtins",
        "jspi",
        "memory-control",
        "memory64",
        "more-array-constructors",
        "multi-memory",
        "multi-value",
        "multibyte-array-access",
        "mutable-globals",
        "numeric-values-in-wat",
        "profiles",
        "reference-types",
        "relaxed-dead-code-validation",
        "relaxed-simd",
        "rounding-variants",
        "saturated-float-to-int",
        "shared-everything-threads",
        "sign-extensions",
        "simd",
        "stack-switching",
        "stringref",
        "tail-call",
        "threads",
        "type-imports",
        "type-reflection",
        "typed-function-references",
        "wasm-c-api",
        "web-content-security-policy",
        "wide-arithmetic"
      ]
    },
    "import": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module",
        "name",
        "kind"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "function"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "stub": {
                "$ref": "#/$defs/functionImportStub"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "global"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "stub": {
                "$ref": "#/$defs/globalImportStub"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "memory",
                  "table",
                  "tag"
                ]
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "not": {
              "required": [
                "stub"
              ]
            }
          }
        }
      ],
      "properties": {
        "module": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "function",
            "global",
            "memory",
            "table",
            "tag"
          ]
        },
        "type": {
          "type": "string"
        },
        "stub": {
          "$ref": "#/$defs/importStub"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "importStub": {
      "oneOf": [
        {
          "$ref": "#/$defs/functionImportStub"
        },
        {
          "$ref": "#/$defs/globalImportStub"
        }
      ]
    },
    "functionImportStub": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "params": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          },
          "default": []
        },
        "returns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          },
          "default": []
        },
        "trap": {
          "type": "string"
        },
        "capture": {
          "$ref": "#/$defs/functionImportCapture"
        },
        "notes": {
          "type": "string"
        }
      },
      "not": {
        "required": [
          "returns",
          "trap"
        ]
      }
    },
    "functionImportCapture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/variableName"
        },
        "param": {
          "$ref": "#/$defs/nonNegativeInteger",
          "default": 0
        },
        "format": {
          "type": "string",
          "enum": [
            "decimal_i32",
            "unicode_code_point",
            "utf16_code_unit"
          ],
          "default": "utf16_code_unit"
        },
        "encoding": {
          "type": "string",
          "enum": [
            "decimal_i32",
            "unicode_code_point",
            "utf16_code_unit"
          ],
          "deprecated": true
        },
        "max_calls": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "globalImportStub": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value"
      ],
      "properties": {
        "value": {
          "$ref": "#/$defs/value"
        },
        "mutable": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "export": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "function",
            "global",
            "memory",
            "table",
            "tag"
          ]
        },
        "type": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "steps"
      ],
      "properties": {
        "description": {
          "type": "string"
        },
        "shared_instance": {
          "type": "boolean",
          "default": false
        },
        "host": {
          "$ref": "#/$defs/host"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          },
          "minItems": 1
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "step": {
      "oneOf": [
        {
          "$ref": "#/$defs/invokeStep"
        },
        {
          "$ref": "#/$defs/commandRunStep"
        },
        {
          "$ref": "#/$defs/componentInvokeStep"
        },
        {
          "$ref": "#/$defs/httpRequestStep"
        },
        {
          "$ref": "#/$defs/memoryWriteStep"
        },
        {
          "$ref": "#/$defs/memoryGrowStep"
        },
        {
          "$ref": "#/$defs/memoryReadStep"
        },
        {
          "$ref": "#/$defs/globalReadStep"
        },
        {
          "$ref": "#/$defs/globalWriteStep"
        },
        {
          "$ref": "#/$defs/tableWriteStep"
        },
        {
          "$ref": "#/$defs/tableReadStep"
        }
      ]
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wasi_preview_1": {
          "$ref": "#/$defs/wasiPreview1Host"
        },
        "wasi_preview_2": {
          "$ref": "#/$defs/wasiComponentHost"
        },
        "wasi_preview_3": {
          "$ref": "#/$defs/wasiComponentHost"
        }
      }
    },
    "wasiPreview1Host": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "command_args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "system_env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "preopened_directories": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "stdin": {
          "$ref": "#/$defs/bytes"
        }
      }
    },
    "wasiComponentHost": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "command_args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "system_env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "preopened_directories": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "default": {}
        },
        "stdin": {
          "$ref": "#/$defs/bytes"
        }
      }
    },
    "invokeStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "function",
        "params",
        "results"
      ],
      "properties": {
        "description": {
          "type": "string"
        },
        "type": {
          "const": "function.invoke"
        },
        "function": {
          "type": "string"
        },
        "params": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/valueExpression"
          },
          "default": []
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resultValue"
          }
        },
        "trap": {
          "type": "string"
        },
        "host_effects": {
          "$ref": "#/$defs/hostEffectsAssertion"
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "commandRunStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "host_effects"
      ],
      "properties": {
        "description": {
          "type": "string"
        },
        "type": {
          "const": "command.run"
        },
        "host_effects": {
          "$ref": "#/$defs/hostEffectsAssertion"
        },
        "trap": {
          "type": "string"
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "componentInvokeStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "function",
        "params",
        "results"
      ],
      "properties": {
        "description": {
          "type": "string"
        },
        "type": {
          "const": "component.invoke"
        },
        "function": {
          "type": "string",
          "minLength": 1
        },
        "params": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/componentValueExpression"
          }
        },
        "results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/componentResultValue"
          }
        },
        "trap": {
          "type": "string"
        },
        "host_effects": {
          "$ref": "#/$defs/hostEffectsAssertion"
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 1
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "httpRequestStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "method", "path", "response"],
      "properties": {
        "description": { "type": "string" },
        "type": { "const": "http.request" },
        "method": { "type": "string", "minLength": 1 },
        "scheme": { "type": "string", "minLength": 1, "default": "http" },
        "authority": { "type": "string", "minLength": 1, "default": "localhost" },
        "path": { "type": "string", "pattern": "^/" },
        "headers": {
          "type": "array",
          "items": { "$ref": "#/$defs/httpHeader" },
          "default": []
        },
        "body": { "$ref": "#/$defs/bytes" },
        "body_chunks": {
          "type": "array",
          "items": { "$ref": "#/$defs/bytes" },
          "minItems": 1
        },
        "outbound": {
          "type": "array",
          "items": { "$ref": "#/$defs/httpOutbound" },
          "default": []
        },
        "response": { "$ref": "#/$defs/httpResponseAssertion" },
        "timeout_ms": { "type": "integer", "minimum": 1 },
        "notes": { "type": "string" }
      },
      "not": { "required": ["body", "body_chunks"] }
    },
    "httpHeader": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "value": { "type": "string" }
      }
    },
    "httpOutbound": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "url", "response"],
      "properties": {
        "method": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https?://" },
        "response": { "$ref": "#/$defs/httpStubResponse" }
      }
    },
    "httpStubResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "type": "integer", "minimum": 100, "maximum": 599 },
        "headers": {
          "type": "array",
          "items": { "$ref": "#/$defs/httpHeader" },
          "default": []
        },
        "body": { "$ref": "#/$defs/bytes" },
        "echo_request_body": { "type": "boolean", "default": false }
      },
      "not": { "required": ["body", "echo_request_body"] }
    },
    "httpResponseAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "type": "integer", "minimum": 100, "maximum": 599 },
        "headers": {
          "type": "array",
          "items": { "$ref": "#/$defs/httpHeader" },
          "default": []
        },
        "body": { "$ref": "#/$defs/bytes" },
        "body_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "body_contains": {
          "type": "array",
          "items": { "$ref": "#/$defs/bytes" },
          "default": []
        },
        "body_not_contains": {
          "type": "array",
          "items": { "$ref": "#/$defs/bytes" },
          "default": []
        },
        "body_line_count": { "type": "integer", "minimum": 0 }
      }
    },
    "memoryWriteStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "offset"
      ],
      "properties": {
        "description": {
          "type": "string"
        },
        "type": {
          "const": "memory.write"
        },
        "memory": {
          "type": "string",
          "default": "memory"
        },
        "offset": {
          "$ref": "#/$defs/integerExpression"
        },
        "bytes": {
          "$ref": "#/$defs/bytes"
        },
        "value": {
          "$ref": "#/$defs/valueExpression"
        },
        "notes": {
          "type": "string"
        }
      },
      "oneOf": [
        {
          "required": [
            "bytes"
          ]
        },
        {
          "required": [
            "value"
          ]
        }
      ]
    },
    "memoryGrowStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "pages"
      ],
      "properties": {
        "description": {
          "type": "string"
        },
        "type": {
          "const": "memory.grow"
        },
        "memory": {
          "type": "string",
          "default": "memory"
        },
        "pages": {
          "$ref": "#/$defs/integerExpression"
        },
        "assert": {
          "$ref": "#/$defs/numericValueAssertion"
        },
        "capture": {
          "$ref": "#/$defs/variableName"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "memoryReadStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "offset"
      ],
      "properties": {
        "description": {
          "type": "string"
        },
        "type": {
          "const": "memory.read"
        },
        "memory": {
          "type": "string",
          "default": "memory"
        },
        "offset": {
          "$ref": "#/$defs/integerExpression"
        },
        "length": {
          "$ref": "#/$defs/integerExpression"
        },
        "assert": {
          "$ref": "#/$defs/memoryReadAssertion"
        },
        "capture": {
          "$ref": "#/$defs/memoryReadCapture"
        },
        "notes": {
          "type": "string"
        }
      },
      "oneOf": [
        {
          "required": [
            "assert"
          ]
        },
        {
          "required": [
            "capture"
          ]
        }
      ]
    },
    "globalReadStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "global",
        "assert"
      ],
      "properties": {
        "description": {
          "type": "string"
        },
        "type": {
          "const": "global.read"
        },
        "global": {
          "type": "string"
        },
        "assert": {
          "$ref": "#/$defs/valueAssertion"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "globalWriteStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "global",
        "value"
      ],
      "properties": {
        "description": {
          "type": "string"
        },
        "type": {
          "const": "global.write"
        },
        "global": {
          "type": "string"
        },
        "value": {
          "$ref": "#/$defs/valueExpression"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "tableWriteStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "index",
        "value"
      ],
      "properties": {
        "description": {
          "type": "string"
        },
        "type": {
          "const": "table.write"
        },
        "table": {
          "type": "string",
          "default": "table"
        },
        "index": {
          "$ref": "#/$defs/integerExpression"
        },
        "value": {
          "$ref": "#/$defs/tableValue"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "tableReadStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "index",
        "assert"
      ],
      "properties": {
        "description": {
          "type": "string"
        },
        "type": {
          "const": "table.read"
        },
        "table": {
          "type": "string",
          "default": "table"
        },
        "index": {
          "$ref": "#/$defs/integerExpression"
        },
        "assert": {
          "$ref": "#/$defs/valueAssertion"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "hostEffectsAssertion": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exit_code": {
          "type": "integer",
          "minimum": 0
        },
        "stdout": {
          "$ref": "#/$defs/bytesAssertion"
        },
        "stderr": {
          "$ref": "#/$defs/bytesAssertion"
        },
        "import_captures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hostImportCaptureAssertion"
          },
          "minItems": 1
        }
      }
    },
    "hostImportCaptureAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "oneOf": [
        {
          "required": [
            "bytes"
          ]
        },
        {
          "required": [
            "text"
          ]
        }
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/variableName"
        },
        "bytes": {
          "$ref": "#/$defs/bytesAssertion"
        },
        "text": {
          "type": "string"
        }
      }
    },
    "trapAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "message"
      ],
      "properties": {
        "type": {
          "const": "trap"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "bytesAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "bytes"
      ],
      "properties": {
        "type": {
          "const": "bytes"
        },
        "bytes": {
          "$ref": "#/$defs/bytes"
        }
      }
    },
    "memoryReadAssertion": {
      "oneOf": [
        {
          "$ref": "#/$defs/bytesAssertion"
        },
        {
          "$ref": "#/$defs/numericValueAssertion"
        }
      ]
    },
    "numericValueAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "value"
        },
        "value": {
          "$ref": "#/$defs/numericValueAssertionValue"
        }
      }
    },
    "memoryReadCapture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "capture"
      ],
      "properties": {
        "type": {
          "$ref": "#/$defs/numericValueType"
        },
        "capture": {
          "$ref": "#/$defs/variableName"
        }
      }
    },
    "valueAssertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "const": "value"
        },
        "value": {
          "$ref": "#/$defs/valueAssertionValue"
        }
      }
    },
    "bytes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "encoding",
        "value"
      ],
      "properties": {
        "encoding": {
          "type": "string",
          "enum": [
            "hex",
            "base64",
            "utf8"
          ]
        },
        "value": {
          "type": "string"
        }
      }
    },
    "tableValue": {
      "oneOf": [
        {
          "$ref": "#/$defs/nullReferenceValue"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "export"
          ],
          "properties": {
            "type": {
              "const": "funcref"
            },
            "export": {
              "type": "string"
            }
          }
        }
      ]
    },
    "value": {
      "oneOf": [
        {
          "$ref": "#/$defs/numericValue"
        },
        {
          "$ref": "#/$defs/nullReferenceValue"
        }
      ]
    },
    "valueAssertionValue": {
      "oneOf": [
        {
          "$ref": "#/$defs/value"
        },
        {
          "$ref": "#/$defs/typeOnlyValue"
        }
      ]
    },
    "numericValueAssertionValue": {
      "oneOf": [
        {
          "$ref": "#/$defs/numericValue"
        },
        {
          "$ref": "#/$defs/numericTypeOnlyValue"
        }
      ]
    },
    "resultValue": {
      "oneOf": [
        {
          "$ref": "#/$defs/valueAssertionValue"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type",
            "capture"
          ],
          "properties": {
            "type": {
              "oneOf": [
                {
                  "$ref": "#/$defs/numericValueType"
                },
                {
                  "$ref": "#/$defs/referenceValueType"
                }
              ]
            },
            "value": {
              "type": [
                "string",
                "null"
              ]
            },
            "capture": {
              "$ref": "#/$defs/variableName"
            }
          }
        }
      ]
    },
    "valueExpression": {
      "oneOf": [
        {
          "$ref": "#/$defs/value"
        },
        {
          "$ref": "#/$defs/variableValue"
        }
      ]
    },
    "componentValueType": {
      "type": "string",
      "enum": [
        "bool",
        "u8",
        "u16",
        "u32",
        "u64",
        "s8",
        "s16",
        "s32",
        "s64",
        "float32",
        "float64",
        "char",
        "string",
        "list",
        "record",
        "tuple",
        "variant",
        "enum",
        "option",
        "result",
        "flags",
        "resource"
      ]
    },
    "componentScalarValue": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": { "const": "bool" },
            "value": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": {
              "enum": ["u8", "u16", "u32", "u64", "s8", "s16", "s32", "s64"]
            },
            "value": {
              "type": "string",
              "pattern": "^-?[0-9]+$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": { "enum": ["float32", "float64"] },
            "value": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": { "const": "char" },
            "value": { "type": "string", "minLength": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": { "const": "string" },
            "value": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": { "const": "enum" },
            "value": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "value"],
          "properties": {
            "type": { "const": "flags" },
            "value": {
              "type": "array",
              "items": { "type": "string" },
              "uniqueItems": true
            }
          }
        }
      ]
    },
    "componentSequenceValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": { "enum": ["list", "tuple"] },
        "value": {
          "type": "array",
          "items": { "$ref": "#/$defs/componentLiteralValue" }
        }
      }
    },
    "componentRecordValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": { "const": "record" },
        "value": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/componentLiteralValue" }
        }
      }
    },
    "componentVariantValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "case", "value"],
      "properties": {
        "type": { "const": "variant" },
        "case": { "type": "string" },
        "value": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/componentLiteralValue" }
          ]
        }
      }
    },
    "componentOptionValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": { "const": "option" },
        "value": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/componentLiteralValue" }
          ]
        }
      }
    },
    "componentResultLiteralValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "case", "value"],
      "properties": {
        "type": { "const": "result" },
        "case": { "enum": ["ok", "err"] },
        "value": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/componentLiteralValue" }
          ]
        }
      }
    },
    "componentLiteralValue": {
      "oneOf": [
        { "$ref": "#/$defs/componentScalarValue" },
        { "$ref": "#/$defs/componentSequenceValue" },
        { "$ref": "#/$defs/componentRecordValue" },
        { "$ref": "#/$defs/componentVariantValue" },
        { "$ref": "#/$defs/componentOptionValue" },
        { "$ref": "#/$defs/componentResultLiteralValue" }
      ]
    },
    "componentVariableValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "var"
      ],
      "properties": {
        "type": {
          "$ref": "#/$defs/componentValueType"
        },
        "var": {
          "$ref": "#/$defs/variableName"
        }
      }
    },
    "componentCapturedValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "capture"
      ],
      "properties": {
        "type": {
          "$ref": "#/$defs/componentValueType"
        },
        "capture": {
          "$ref": "#/$defs/variableName"
        }
      }
    },
    "componentValueExpression": {
      "oneOf": [
        {
          "$ref": "#/$defs/componentLiteralValue"
        },
        {
          "$ref": "#/$defs/componentVariableValue"
        }
      ]
    },
    "componentResultValue": {
      "oneOf": [
        {
          "$ref": "#/$defs/componentLiteralValue"
        },
        {
          "$ref": "#/$defs/componentCapturedValue"
        }
      ]
    },
    "numericValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "$ref": "#/$defs/numericValueType"
        },
        "value": {
          "type": "string"
        }
      }
    },
    "variableValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "var"
      ],
      "properties": {
        "type": {
          "$ref": "#/$defs/numericValueType"
        },
        "var": {
          "$ref": "#/$defs/variableName"
        }
      }
    },
    "nullReferenceValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "value"
      ],
      "properties": {
        "type": {
          "$ref": "#/$defs/referenceValueType"
        },
        "value": {
          "const": null
        }
      }
    },
    "typeOnlyValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "oneOf": [
            {
              "$ref": "#/$defs/numericValueType"
            },
            {
              "$ref": "#/$defs/referenceValueType"
            }
          ]
        }
      }
    },
    "numericTypeOnlyValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "$ref": "#/$defs/numericValueType"
        }
      }
    },
    "numericValueType": {
      "type": "string",
      "enum": [
        "i32",
        "i64",
        "f32",
        "f64"
      ]
    },
    "referenceValueType": {
      "type": "string",
      "enum": [
        "externref",
        "funcref"
      ]
    },
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "integerExpression": {
      "oneOf": [
        {
          "$ref": "#/$defs/nonNegativeInteger"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "var"
          ],
          "properties": {
            "var": {
              "$ref": "#/$defs/variableName"
            }
          }
        }
      ]
    },
    "variableName": {
      "type": "string",
      "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contributor": {
          "type": "string",
          "enum": [
            "human",
            "ai"
          ]
        },
        "language": {
          "type": "string",
          "enum": [
            "assemblyscript",
            "c",
            "cpp",
            "d",
            "go",
            "grain",
            "haskell",
            "javascript",
            "kotlin",
            "moonbit",
            "motoko",
            "ocaml",
            "odin",
            "roc",
            "rust",
            "scheme",
            "swift",
            "v",
            "zig",
            "wat"
          ]
        },
        "path": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      },
      "required": [
        "contributor",
        "language"
      ]
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "command": {
          "type": "string"
        }
      }
    }
  }
}

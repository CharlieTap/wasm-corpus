  "tests": [
    {
      "description": "parse tables, arrays, integers, and strings from TOML",
      "steps": [
        {
          "type": "function.invoke",
          "function": "_initialize",
          "params": [],
          "results": []
        },
        {
          "type": "function.invoke",
          "description": "allocate 128 bytes",
          "function": "malloc",
          "params": [
            {
              "type": "i32",
              "value": "128"
            }
          ],
          "results": [
            {
              "type": "i32",
              "capture": "toml"
            }
          ]
        },
        {
          "type": "function.invoke",
          "description": "allocate 64 bytes",
          "function": "malloc",
          "params": [
            {
              "type": "i32",
              "value": "64"
            }
          ],
          "results": [
            {
              "type": "i32",
              "capture": "errors"
            }
          ]
        },
        {
          "type": "function.invoke",
          "description": "allocate 16 bytes",
          "function": "malloc",
          "params": [
            {
              "type": "i32",
              "value": "16"
            }
          ],
          "results": [
            {
              "type": "i32",
              "capture": "key"
            }
          ]
        },
        {
          "type": "memory.write",
          "memory": "memory",
          "offset": {
            "var": "toml"
          },
          "bytes": {
            "encoding": "utf8",
            "value": "title = \"Corpus\"\nports = [8000, 8001, 8002]\n[owner]\nname = \"Wasm\"\n\u0000"
          }
        },
        {
          "type": "memory.write",
          "memory": "memory",
          "offset": {
            "var": "key"
          },
          "bytes": {
            "encoding": "utf8",
            "value": "ports\u0000"
          }
        },
        {
          "type": "function.invoke",
          "function": "toml_parse",
          "params": [
            {
              "type": "i32",
              "var": "toml"
            },
            {
              "type": "i32",
              "var": "errors"
            },
            {
              "type": "i32",
              "value": "64"
            }
          ],
          "results": [
            {
              "type": "i32",
              "capture": "table"
            }
          ]
        },
        {
          "type": "function.invoke",
          "function": "toml_key_exists",
          "params": [
            {
              "type": "i32",
              "var": "table"
            },
            {
              "type": "i32",
              "var": "key"
            }
          ],
          "results": [
            {
              "type": "i32",
              "value": "1"
            }
          ]
        },
        {
          "type": "function.invoke",
          "function": "toml_array_in",
          "params": [
            {
              "type": "i32",
              "var": "table"
            },
            {
              "type": "i32",
              "var": "key"
            }
          ],
          "results": [
            {
              "type": "i32",
              "capture": "array"
            }
          ]
        },
        {
          "type": "function.invoke",
          "function": "toml_array_nelem",
          "params": [
            {
              "type": "i32",
              "var": "array"
            }
          ],
          "results": [
            {
              "type": "i32",
              "value": "3"
            }
          ]
        },
        {
          "type": "function.invoke",
          "function": "toml_free",
          "params": [
            {
              "type": "i32",
              "var": "table"
            }
          ],
          "results": []

{
  "$schema": "../schema/fixture.schema.json",
  "name": "brotli_codec",
  "path": "brotli_codec.wasm",
  "wat": {
    "status": "present",
    "path": "brotli_codec.wat"
  },
  "features": [
    "bulk-memory",
    "saturated-float-to-int",
    "sign-extensions",
    "tail-call"
  ],
  "tags": [
    "domain-compression",
    "duration-short",
    "host-wasi-preview1",
    "size-large"
  ],
  "imports": [
    {
      "module": "wasi_snapshot_preview1",
      "name": "proc_exit",
      "kind": "function",
      "type": "(func (param i32))"
    }
  ],
  "exports": [
    {
      "name": "memory",
      "kind": "memory",
      "type": "(memory 263)"
    },
    {
      "name": "_initialize",
      "kind": "function",
      "type": "(func)"
    },
    {
      "name": "malloc",
      "kind": "function",
      "type": "(func (param i32) (result i32))"
    },
    {
      "name": "free",
      "kind": "function",
      "type": "(func (param i32))"
    },
    {
      "name": "BrotliEncoderMaxCompressedSize",
      "kind": "function",
      "type": "(func (param i32) (result i32))"
    },
    {
      "name": "BrotliEncoderCompress",
      "kind": "function",
      "type": "(func (param i32 i32 i32 i32 i32 i32 i32) (result i32))"
    },
    {
      "name": "BrotliDecoderDecompress",
      "kind": "function",
      "type": "(func (param i32 i32 i32 i32) (result i32))"
    },
    {
      "name": "BrotliDecoderErrorString",
      "kind": "function",
      "type": "(func (param i32) (result i32))"
    }
  ],
  "tests": [
    {
      "description": "round-trip text through the Brotli encoder and decoder",
      "steps": [
        {
          "type": "function.invoke",
          "description": "allocate 55 bytes",
          "function": "malloc",
          "params": [
            {
              "type": "i32",
              "value": "55"
            }
          ],
          "results": [
            {
              "type": "i32",
              "capture": "input"
            }
          ]
        },
        {
          "type": "function.invoke",
          "description": "allocate 256 bytes",
          "function": "malloc",
          "params": [
            {
              "type": "i32",
              "value": "256"
            }
          ],
          "results": [
            {
              "type": "i32",
              "capture": "compressed"
            }
          ]
        },
        {
          "type": "function.invoke",
          "description": "allocate 4 bytes",
          "function": "malloc",
          "params": [
            {
              "type": "i32",
              "value": "4"
            }
          ],
          "results": [
            {
              "type": "i32",
              "capture": "compressed_len_ptr"
            }
          ]
        },
        {
          "type": "function.invoke",
          "description": "allocate 256 bytes",
          "function": "malloc",
          "params": [
            {
              "type": "i32",
              "value": "256"
            }
          ],
          "results": [
            {
              "type": "i32",
              "capture": "restored"
            }
          ]
        },
        {
          "type": "function.invoke",
          "description": "allocate 4 bytes",
          "function": "malloc",
          "params": [
            {
              "type": "i32",
              "value": "4"
            }
          ],
          "results": [
            {
              "type": "i32",
              "capture": "restored_len_ptr"
            }
          ]
        },
        {
          "type": "memory.write",
          "memory": "memory",
          "offset": {
            "var": "input"
          },
          "bytes": {
            "encoding": "utf8",
            "value": "WebAssembly corpus compression compression compression!"
          }
        },
        {
          "type": "memory.write",
          "memory": "memory",
          "offset": {
            "var": "compressed_len_ptr"
          },
          "value": {
            "type": "i32",
            "value": "256"
          }
        },
        {
          "type": "memory.write",
          "memory": "memory",
          "offset": {
            "var": "restored_len_ptr"
          },
          "value": {
            "type": "i32",
            "value": "256"
          }
        },
        {
          "type": "function.invoke",
          "function": "BrotliEncoderCompress",
          "params": [
            {
              "type": "i32",
              "value": "9"
            },
            {
              "type": "i32",
              "value": "20"
            },
            {
              "type": "i32",
              "value": "0"
            },
            {
              "type": "i32",
              "value": "55"
            },
            {
              "type": "i32",
              "var": "input"
            },
            {
              "type": "i32",
              "var": "compressed_len_ptr"
            },
            {
              "type": "i32",
              "var": "compressed"
            }
          ],
          "results": [
            {
              "type": "i32",
              "value": "1"
            }
          ]
        },
        {
          "type": "memory.read",
          "memory": "memory",
          "offset": {
            "var": "compressed_len_ptr"
          },
          "capture": {
            "type": "i32",
            "capture": "compressed_len"
          }
        },
        {
          "type": "function.invoke",
          "function": "BrotliDecoderDecompress",
          "params": [
            {
              "type": "i32",
              "var": "compressed_len"
            },
            {
              "type": "i32",
              "var": "compressed"
            },
            {
              "type": "i32",
              "var": "restored_len_ptr"
            },
            {
              "type": "i32",
              "var": "restored"
            }
          ],
          "results": [
            {
              "type": "i32",
              "value": "1"
            }
          ]
        },
        {
          "type": "memory.read",
          "memory": "memory",
          "offset": {
            "var": "restored_len_ptr"
          },
          "assert": {
            "type": "value",
            "value": {
              "type": "i32",
              "value": "55"
            }
          }
        },
        {
          "type": "memory.read",
          "memory": "memory",
          "offset": {
            "var": "restored"
          },
          "assert": {
            "type": "bytes",
            "bytes": {
              "encoding": "utf8",
              "value": "WebAssembly corpus compression compression compression!"
            }
          }
        }
      ],
      "host": {
        "wasi_preview_1": {
          "command_args": [
            "brotli_codec"
          ],
          "system_env": {},
          "preopened_directories": {},
          "stdin": {
            "encoding": "utf8",
            "value": ""
          }
        }
      }
    }
  ],
  "sha256": "f2ce6e5b5c0c32aebab6d8fe18d05e22efa7f1f76cbd8fb0699ff62b55c55957",
  "source": {
    "contributor": "human",
    "language": "c",
    "path": "c/enc/encode.c",
    "url": "https://github.com/google/brotli/blob/2ff28fb62deeb8c49720acf2c16ecc8f6f7408f1/c/enc/encode.c",
    "description": "Brotli encoder and decoder library. Compiled from the upstream project's human-authored source at commit 2ff28fb62deeb8c49720acf2c16ecc8f6f7408f1."
  },
  "toolchain": {
    "name": "Zig/LLVM",
    "version": "zig 0.16.0; wasm-opt version 131",
    "command": "zig cc -target wasm32-wasi -O2 -g0 -mtail-call c/enc/encode.c ...; ./scripts/prepare"
  },
  "description": "Brotli encoder and decoder library.",
  "notes": "The fixture contains no generated workload or wrapper program: it is the upstream command/test source or library implementation itself. The metadata test drives the project's public API with representative data. Build-only configuration selects WASI-compatible facilities and does not replace project behavior."
}

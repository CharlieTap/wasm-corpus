  },
  "toolchain": {
    "name": "Binaryen",
    "version": "wasm-opt version 125",
    "command": "./scripts/prepare"
  },
  "description": "Internally amplified array.init_data copies spanning call-dominated and bulk sizes.",
  "tags": [
    "benchmark",

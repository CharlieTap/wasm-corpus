  },
  "features": [
    "bulk-memory",
    "gc",
    "reference-types"
  ],
  "exports": [
    {
      "name": "bench",
      "kind": "function",
      "type": "(func (param i32 i32) (result i32))"
    }
  ],
  "tests": [
    {
      "description": "repeat one-byte array.init_data copies",
      "steps": [
        {
          "type": "function.invoke",
          "function": "bench",
          "params": [
            {
              "type": "i32",
              "value": "20000000"
            },
            {
              "type": "i32",
              "value": "1"
            }
          ],
          "results": [
            {
              "type": "i32",
              "value": "48"
            }
          ]
        }
      ]
    },
    {
      "description": "repeat eight-byte array.init_data copies",
      "steps": [
        {
          "type": "function.invoke",
          "function": "bench",
          "params": [
            {
              "type": "i32",
              "value": "20000000"
            },
            {
              "type": "i32",
              "value": "8"
            }
          ],
          "results": [
            {
              "type": "i32",
              "value": "55"
            }
          ]
        }
      ]
    },
    {
      "description": "repeat 32-byte array.init_data copies",
      "steps": [
        {
          "type": "function.invoke",
          "function": "bench",
          "params": [
            {
              "type": "i32",
              "value": "12000000"
            },
            {
              "type": "i32",
              "value": "32"
            }
          ],
          "results": [
            {
              "type": "i32",
              "value": "102"
            }
          ]
        }
      ]
    },
    {
      "description": "repeat 256-byte array.init_data copies",
      "steps": [
        {
          "type": "function.invoke",
          "function": "bench",
          "params": [
            {
              "type": "i32",
              "value": "4000000"
            },
            {
              "type": "i32",
              "value": "256"
            }
          ],
          "results": [
            {
              "type": "i32",
              "value": "102"
            }
          ]
        }
      ]
    }
  ],
  "sha256": "9a86ed8d1bd1af2445b35d75f0ea8dea0bf2269a8a3ed73e686707584e012954",
  "source": {
    "contributor": "ai",
    "language": "wat",

      "type": "(func (param i32 i32))",
      "description": "WASM-4 UTF-8 trace callback; unused by the exercised paths."
    },
    {
      "module": "env",
      "name": "textUtf8",
      "kind": "function",
      "type": "(func (param i32 i32 i32 i32))",
      "stub": {
        "capture": {
          "name": "title_x",
          "param": 2,
          "format": "decimal_i32",
          "max_calls": 1
        }
      },
      "description": "WASM-4 text callback; captures the title's x coordinate."
    },
    {
      "module": "env",
      "name": "rect",
      "kind": "function",
      "type": "(func (param i32 i32 i32 i32))",
      "stub": {
        "capture": {
          "name": "snake_rect_x_prefix",
          "param": 0,
          "format": "decimal_i32",
          "max_calls": 3
        }
      },
      "description": "WASM-4 rectangle callback used to draw snake body segments and the head."
    },
    {
      "module": "env",
      "name": "blitSub",
      "kind": "function",
      "type": "(func (param i32 i32 i32 i32 i32 i32 i32 i32 i32))",
      "stub": {
        "capture": {
          "name": "fruit_x_prefix",
          "param": 1,
          "format": "decimal_i32",
          "max_calls": 16
        }
      },
      "description": "WASM-4 sprite callback used to draw fruit; captures x positions through the first fruit replacement."
    },
    {
      "module": "env",
      "name": "memory",
      "kind": "memory",
      "type": "(memory 1 1)"
    }
  ],

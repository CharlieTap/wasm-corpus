{
  "$schema": "../schema/fixture.schema.json",
  "name": "moonbit_lunaboy",
  "path": "moonbit_lunaboy.wasm",
  "wat": {
    "status": "present",
    "path": "moonbit_lunaboy.wat"
  },
  "description": "MoonBit Game Boy emulator fixture loading an upstream test ROM, running cycles, rendering a frame, handling input, and producing an audio buffer length.",
  "features": [
    "bulk-memory",
    "gc",
    "multi-value",
    "mutable-globals",
    "reference-types",
    "sign-extensions",
    "typed-function-references"
  ],
  "imports": [
    {
      "module": "spectest",
      "name": "print_char",
      "kind": "function",
      "type": "(func (param (ref 7) i32) (result i32))",
      "description": "No-op character printer used by the emulator for diagnostic output.",
      "stub": {
        "returns": [
          {
            "type": "i32",
            "value": "0"
          }
        ]
      }
    }
  ],
  "exports": [
    {
      "name": "moonbit.memory",
      "kind": "memory",
      "type": "(memory 1)"
    },
    {
      "name": "pop_audio_extern",
      "kind": "function",
      "type": "(func (param (ref 4) i32 i32) (result (ref 6)))"
    },
    {
      "name": "set_input_extern",
      "kind": "function",
      "type": "(func (param (ref 2) i32 i32) (result i32))"
    },
    {
      "name": "run_cycles_extern",
      "kind": "function",
      "type": "(func (param i32) (result i32))"
    },
    {
      "name": "run_frame_extern",
      "kind": "function",
      "type": "(func (param (ref 16) (ref 2)) (result i32))"
    },
    {
      "name": "init_extern",
      "kind": "function",
      "type": "(func (param (ref 7) i32) (result i32))"
    }
  ],
  "tests": [
    {
      "description": "load a Game Boy test ROM and render one emulator frame",
      "steps": [
        {
          "type": "memory.grow",
          "description": "pre-size linear memory for ROM and framebuffer buffers",
          "memory": "moonbit.memory",
          "pages": 1,
          "assert": {
            "type": "value",
            "value": {
              "type": "i32",
              "value": "1"
            }
          }
        },
        {
          "type": "memory.write",
          "description": "copy upstream bgbtest.gb ROM bytes to offset zero",
          "memory": "moonbit.memory",
          "offset": 0,
          "bytes": {
            "encoding": "base64",
            "value": ""
          }
        },
        {
          "type": "function.invoke",
          "description": "initialize emulator state from the staged ROM",
          "function": "init_extern",
          "params": [
            {
              "type": "i32",
              "value": "32768"
            }
          ],
          "results": []
        },
        {
          "type": "function.invoke",
          "description": "execute a single CPU cycle batch",
          "function": "run_cycles_extern",
          "params": [
            {
              "type": "i32",
              "value": "1"
            }
          ],
          "results": [
            {
              "type": "i32",
              "value": "0"
            }
          ]
        },
        {
          "type": "function.invoke",
          "description": "execute a larger CPU cycle batch",
          "function": "run_cycles_extern",
          "params": [
            {
              "type": "i32",
              "value": "8192"
            }
          ],
          "results": [
            {
              "type": "i32",
              "value": "0"
            }
          ]
        },
        {
          "type": "function.invoke",
          "description": "render one frame into exported memory",
          "function": "run_frame_extern",
          "params": [],
          "results": []
        },
        {
          "type": "function.invoke",
          "description": "toggle a pair of joypad inputs",
          "function": "set_input_extern",
          "params": [
            {
              "type": "i32",
              "value": "15"
            },
            {
              "type": "i32",
              "value": "15"
            }
          ],
          "results": []
        },
        {
          "type": "function.invoke",
          "description": "pop the generated audio buffer length",
          "function": "pop_audio_extern",
          "params": [],
          "results": [
            {
              "type": "i32",
              "value": "2048"
            }
          ]
        },
        {
          "type": "memory.read",
          "description": "check the first rendered framebuffer pixel is opaque white",
          "memory": "moonbit.memory",
          "offset": 0,
          "length": 4,
          "assert": {
            "type": "bytes",
            "bytes": {
              "encoding": "hex",
              "value": "ffffffff"
            }
          }
        }
      ]
    }
  ],
  "sha256": "77b5591f45b4c18dbf446d3280719f361d7a767d182d5cafaddd282abf2af8ae",
  "source": {
    "contributor": "human",
    "language": "MoonBit",
    "url": "https://github.com/sacckey/lunaboy",
    "path": "docs/lib.wasm",
    "description": "sacckey/lunaboy checked-in WebAssembly GC build, tested with the upstream docs/roms/bgbtest.gb ROM."
  },
  "toolchain": {
    "name": "Binaryen",
    "version": "wasm-opt version 125",
    "command": "./scripts/prepare"
  },
  "tags": [
    "moonbit",
    "game-boy",
    "emulator",
    "rom",
    "wasm3",
    "gc"
  ],
  "notes": "The browser wrapper grows exported memory before copying ROM and framebuffer data; the test models that host setup explicitly with memory.grow."
}

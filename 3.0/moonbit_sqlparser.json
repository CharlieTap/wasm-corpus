{
  "$schema": "../schema/fixture.schema.json",
  "name": "moonbit_sqlparser",
  "description": "MoonBit SQL parser fixture exercising tokenization, SELECT/JOIN parsing, transaction statement parsing, and syntax-error handling.",
  "path": "moonbit_sqlparser.wasm",
  "wat": {

      "kind": "function",
      "type": "(func (result i32))"
    },
    {
      "name": "join_statement_score",
      "kind": "function",
      "type": "(func (result i32))"
    },
    {
      "name": "select_token_score",
      "kind": "function",
      "type": "(func (result i32))"
    }
  ],
  "tests": [

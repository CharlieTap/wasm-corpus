      "steps": [
        {
          "type": "function.invoke",
          "description": "tokenize SELECT with WHERE and ORDER BY",
          "function": "select_token_score",
          "params": [],
          "results": [
            {
              "type": "i32",
              "value": "14"
            }
          ]
        },
        {
          "type": "function.invoke",
          "description": "parse SELECT with JOIN, GROUP BY, ORDER BY, and LIMIT",
          "function": "join_statement_score",
          "params": [],
          "results": [
            {
              "type": "i32",
              "value": "1"
            }
          ]
        },
        {
          "type": "function.invoke",
          "description": "parse BEGIN, INSERT, and COMMIT statements",
          "function": "transaction_statement_score",
          "params": [],
          "results": [
            {
              "type": "i32",
              "value": "3"
            }
          ]
        },
        {
          "type": "function.invoke",
          "description": "reject an invalid SELECT statement",
          "function": "invalid_sql_score",
          "params": [],
          "results": [
            {
              "type": "i32",
              "value": "1"
            }
          ]
        },
        {
          "type": "function.invoke",
          "description": "parse and tokenize a suite of CREATE, INSERT, UPDATE, DELETE, GRANT, and nested SELECT statements",
          "function": "statement_suite_score",
          "params": [],
          "results": [
            {
              "type": "i32",
              "value": "98"
            }
          ]
        }
      ]
    }
  ],
  "sha256": "11ba7fcb2df23557b136c92d3d79c7359d121c6a9d2854c21e755c9c540bca07",
  "source": {
    "contributor": "human",
    "language": "moonbit",
    "url": "https://github.com/moonbit-community/sqlparser",
    "path": "src/fixture/fixture.mbt",
    "description": "moonbit-community/sqlparser compiled with a local export harness around tokenize and parse_sql."
  },
  "toolchain": {
    "name": "Binaryen",
    "version": "wasm-opt version 125",
    "command": "./scripts/prepare"
  },
  "notes": "The harness uses fixed SQL snippets so tests can assert primitive counts while exercising lexer, parser, AST, and error paths. Includes a suite export that drives several SQL statement categories and tokenization paths, not just a single SELECT."

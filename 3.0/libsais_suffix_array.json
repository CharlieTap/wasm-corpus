  ],
  "exports": [
    {
      "name": "memory",
      "kind": "memory",
      "type": "(memory 257)"
    },
    {
      "name": "_initialize",
      "kind": "function",
      "type": "(func)"
    },
    {
      "name": "malloc",
      "kind": "function",
      "type": "(func (param i32) (result i32))"
    },
    {
      "name": "free",
      "kind": "function",
      "type": "(func (param i32))"
    },
    {
      "name": "libsais",
      "kind": "function",
      "type": "(func (param i32 i32 i32 i32 i32) (result i32))"
    }
  ],
  "tests": [
    {
      "description": "construct and verify a suffix array for repeated natural-language text",
      "steps": [
        {
          "type": "function.invoke",
          "function": "_initialize",
          "params": [],
          "results": []
        },
        {
          "type": "function.invoke",
          "description": "allocate the 93-byte input",
          "function": "malloc",
          "params": [
            {
              "type": "i32",
              "value": "93"
            }
          ],
          "results": [
            {
              "type": "i32",
              "capture": "input"
            }
          ]
        },
        {
          "type": "function.invoke",
          "description": "allocate 93 suffix-array entries",
          "function": "malloc",
          "params": [
            {
              "type": "i32",
              "value": "372"
            }
          ],
          "results": [
            {
              "type": "i32",
              "capture": "suffix_array"
            }
          ]
        },
        {
          "type": "function.invoke",
          "description": "allocate the 256-entry symbol-frequency table",
          "function": "malloc",
          "params": [
            {
              "type": "i32",
              "value": "1024"
            }
          ],
          "results": [
            {
              "type": "i32",
              "capture": "frequencies"
            }
          ]
        },
        {
          "type": "memory.write",
          "memory": "memory",
          "offset": {
            "var": "input"
          },
          "bytes": {
            "encoding": "utf8",
            "value": "mississippi river suffix arrays efficiently index repeated substrings in real-world text data"
          }
        },
        {
          "type": "function.invoke",
          "description": "run libsais induced sorting and collect symbol frequencies",
          "function": "libsais",
          "params": [
            {
              "type": "i32",
              "var": "input"
            },
            {
              "type": "i32",
              "var": "suffix_array"
            },
            {
              "type": "i32",
              "value": "93"
            },
            {
              "type": "i32",
              "value": "0"
            },
            {
              "type": "i32",
              "var": "frequencies"
            }
          ],
          "results": [
            {
              "type": "i32",
              "value": "0"
            }
          ]
        },
        {
          "type": "memory.read",
          "description": "assert all 93 suffix positions in lexicographic order",
          "memory": "memory",
          "offset": {
            "var": "suffix_array"
          },
          "assert": {
            "type": "bytes",
            "bytes": {
              "encoding": "hex",
              "value": ""
            }
          }
        }
      ]
    }
  ],
  "sha256": "dd4286359523460233e0076431376b4496ab6eee1c39bb0d5f25fda5e771d76f",
  "source": {
    "contributor": "human",

    "description": "libsais linear-time suffix-array construction, compiled from the upstream project's human-authored source at commit b6e52ef33fe14f9d5c14c580d162b6fd2c27f2a8."
  },
  "toolchain": {
    "name": "Zig/LLVM + Binaryen",
    "version": "zig 0.16.0; wasm-opt version 131",
    "command": "zig cc -target wasm32-wasi -mexec-model=reactor -O2 -g0 -mtail-call src/libsais.c ...; ./scripts/prepare"
  },
  "description": "libsais induced-sorting suffix-array construction library.",
  "notes": "The fixture is compiled directly from libsais's upstream implementation without a generated workload or wrapper program. The metadata test invokes the public suffix-array API on repeated natural-language text, requests the full frequency-table path, and verifies every output suffix position."

            {
              "type": "i32",
              "value": "1"
            }
          ]
        },
        {
          "type": "function.invoke",
          "description": "construct CSV data with generated headers",
          "function": "generated_header_score",
          "params": [],
          "results": [
            {
              "type": "i32",
              "value": "1"
            }
          ]
        },
        {
          "type": "function.invoke",
          "description": "parse custom-delimited multiline quoted fields",
          "function": "multiline_field_score",
          "params": [],
          "results": [
            {
              "type": "i32",
              "value": "1"
            }
          ]
        },
        {
          "type": "function.invoke",
          "description": "parse a larger CSV covering escaped quotes, multiline fields, empty fields, JSON text, and re-rendering",
          "function": "large_csv_suite_score",
          "params": [],

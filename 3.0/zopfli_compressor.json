  ],
  "imports": [
    {
      "module": "wasi_snapshot_preview1",
      "name": "fd_seek",
      "kind": "function",
      "type": "(func (param i32 i64 i32 i32) (result i32))"
    },
    {
      "module": "wasi_snapshot_preview1",
      "name": "fd_write",
      "kind": "function",
      "type": "(func (param i32 i32 i32 i32) (result i32))"
    },
    {
      "module": "wasi_snapshot_preview1",
      "name": "proc_exit",
      "kind": "function",
      "type": "(func (param i32))"
    }
  ],
  "exports": [
    {
      "name": "memory",
      "kind": "memory",
      "type": "(memory 257)"
    },
    {
      "name": "_initialize",
      "kind": "function",
      "type": "(func)"
    },
    {
      "name": "malloc",
      "kind": "function",
      "type": "(func (param i32) (result i32))"
    },
    {
      "name": "free",
      "kind": "function",
      "type": "(func (param i32))"
    },
    {
      "name": "ZopfliInitOptions",
      "kind": "function",
      "type": "(func (param i32))"
    },
    {
      "name": "ZopfliCompress",
      "kind": "function",
      "type": "(func (param i32 i32 i32 i32 i32 i32))"
    }
  ],
  "tests": [
    {
      "description": "compress repeated text into a standards-compliant gzip stream",
      "steps": [
        {
          "type": "function.invoke",
          "description": "allocate 64 bytes",
          "function": "malloc",
          "params": [
            {
              "type": "i32",
              "value": "64"
            }
          ],
          "results": [
            {
              "type": "i32",
              "capture": "options"
            }
          ]
        },
        {
          "type": "function.invoke",
          "description": "allocate 55 bytes",
          "function": "malloc",
          "params": [
            {
              "type": "i32",
              "value": "55"
            }
          ],
          "results": [
            {
              "type": "i32",
              "capture": "input"
            }
          ]
        },
        {
          "type": "function.invoke",
          "description": "allocate 4 bytes",
          "function": "malloc",
          "params": [
            {
              "type": "i32",
              "value": "4"
            }
          ],
          "results": [
            {
              "type": "i32",
              "capture": "output_ptr"
            }
          ]
        },
        {
          "type": "function.invoke",
          "description": "allocate 4 bytes",
          "function": "malloc",
          "params": [
            {
              "type": "i32",
              "value": "4"
            }
          ],
          "results": [
            {
              "type": "i32",
              "capture": "output_len"
            }
          ]
        },
        {
          "type": "memory.write",
          "memory": "memory",
          "offset": {
            "var": "input"
          },
          "bytes": {
            "encoding": "utf8",
            "value": "WebAssembly corpus compression compression compression!"
          }
        },
        {
          "type": "function.invoke",
          "function": "ZopfliInitOptions",
          "params": [
            {
              "type": "i32",
              "var": "options"
            }
          ],
          "results": []
        },
        {
          "type": "function.invoke",
          "function": "ZopfliCompress",
          "params": [
            {
              "type": "i32",
              "var": "options"
            },
            {
              "type": "i32",
              "value": "0"
            },
            {
              "type": "i32",
              "var": "input"
            },
            {
              "type": "i32",
              "value": "55"
            },
            {
              "type": "i32",
              "var": "output_ptr"
            },
            {
              "type": "i32",
              "var": "output_len"
            }
          ],
          "results": []
        },
        {
          "type": "memory.read",
          "memory": "memory",
          "offset": {
            "var": "output_ptr"
          },
          "capture": {
            "type": "i32",
            "capture": "output"
          }
        },
        {
          "type": "memory.read",
          "description": "assert the deterministic gzip header",
          "memory": "memory",
          "offset": {
            "var": "output"
          },
          "assert": {
            "type": "bytes",
            "bytes": {
              "encoding": "hex",
              "value": "1f8b0800000000000203"
            }
          }
        },
        {
          "type": "function.invoke",
          "function": "free",
          "params": [
            {
              "type": "i32",
              "var": "output"
            }
          ],
          "results": []
        }
      ],
      "host": {
        "wasi_preview_1": {
          "command_args": [
            "zopfli_compressor"
          ],
          "system_env": {},
          "preopened_directories": {},
          "stdin": {
            "encoding": "utf8",
            "value": ""
          }
        }
      }
    }
  ],
  "sha256": "bebb0d7176d9163d769410132b4bcbbd0367157b896fb8fcfefdcc764186caf1",
  "source": {
    "contributor": "human",
    "language": "c",
    "path": "src/zopfli/zopfli_lib.c",
    "url": "https://github.com/google/zopfli/blob/ccf9f0588d4a4509cb1040310ec122243e670ee6/src/zopfli/zopfli_lib.c",
    "description": "Zopfli high-ratio DEFLATE compressor. Compiled from the upstream project's human-authored source at commit ccf9f0588d4a4509cb1040310ec122243e670ee6."
  },
  "toolchain": {
    "name": "Zig/LLVM",
    "version": "zig 0.16.0; wasm-opt version 131",
    "command": "zig cc -target wasm32-wasi -O2 -g0 -mtail-call src/zopfli/zopfli_lib.c ...; ./scripts/prepare"
  },
  "description": "Zopfli high-ratio DEFLATE compressor.",
  "notes": "The fixture contains no generated workload or wrapper program: it is the upstream command/test source or library implementation itself. The metadata test drives the project's public API with representative data. Build-only configuration selects WASI-compatible facilities and does not replace project behavior."

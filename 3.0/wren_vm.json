    "description": "Wren language bytecode virtual machine. Compiled from the upstream project's human-authored source at commit 99d2f0b8fc2686134b32b18166e037639f7e9f2c."
  },
  "toolchain": {
    "name": "Zig/LLVM",
    "version": "zig 0.16.0; wasm-opt version 131",
    "command": "zig cc -target wasm32-wasi -O2 -g0 -mtail-call src/vm/wren_vm.c ...; ./scripts/prepare"
  },
  "description": "Wren language bytecode virtual machine.",

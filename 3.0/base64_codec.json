{
  "$schema": "../schema/fixture.schema.json",
  "name": "base64_codec",
  "path": "base64_codec.wasm",
  "wat": {
    "status": "present",
    "path": "base64_codec.wat"
  },
  "features": [
    "tail-call"
  ],
  "tags": [
    "domain-serialization",
    "domain-string-processing",
    "duration-short",
    "size-medium"
  ],
  "exports": [
    {
      "name": "memory",
      "kind": "memory",
      "type": "(memory 257)"
    },
    {
      "name": "_initialize",
      "kind": "function",
      "type": "(func)"
    },
    {
      "name": "malloc",
      "kind": "function",
      "type": "(func (param i32) (result i32))"
    },
    {
      "name": "free",
      "kind": "function",
      "type": "(func (param i32))"
    },
    {
      "name": "base64_stream_encode_init",
      "kind": "function",
      "type": "(func (param i32 i32))"
    },
    {
      "name": "base64_stream_encode",
      "kind": "function",
      "type": "(func (param i32 i32 i32 i32 i32))"
    },
    {
      "name": "base64_stream_encode_final",
      "kind": "function",
      "type": "(func (param i32 i32 i32))"
    },
    {
      "name": "base64_stream_decode_init",
      "kind": "function",
      "type": "(func (param i32 i32))"
    },
    {
      "name": "base64_stream_decode",
      "kind": "function",
      "type": "(func (param i32 i32 i32 i32 i32) (result i32))"
    },
    {
      "name": "base64_encode",
      "kind": "function",
      "type": "(func (param i32 i32 i32 i32 i32))"
    },
    {
      "name": "base64_decode",
      "kind": "function",
      "type": "(func (param i32 i32 i32 i32 i32) (result i32))"
    }
  ],
  "tests": [
    {
      "description": "encode and decode a text payload with libbase64's streaming codec",
      "steps": [
        {
          "type": "function.invoke",
          "function": "_initialize",
          "params": [],
          "results": []
        },
        {
          "type": "function.invoke",
          "description": "allocate 55 bytes",
          "function": "malloc",
          "params": [
            {
              "type": "i32",
              "value": "55"
            }
          ],
          "results": [
            {
              "type": "i32",
              "capture": "input"
            }
          ]
        },
        {
          "type": "function.invoke",
          "description": "allocate 256 bytes",
          "function": "malloc",
          "params": [
            {
              "type": "i32",
              "value": "256"
            }
          ],
          "results": [
            {
              "type": "i32",
              "capture": "encoded"
            }
          ]
        },
        {
          "type": "function.invoke",
          "description": "allocate 4 bytes",
          "function": "malloc",
          "params": [
            {
              "type": "i32",
              "value": "4"
            }
          ],
          "results": [
            {
              "type": "i32",
              "capture": "encoded_len_ptr"
            }
          ]
        },
        {
          "type": "function.invoke",
          "description": "allocate 256 bytes",
          "function": "malloc",
          "params": [
            {
              "type": "i32",
              "value": "256"
            }
          ],
          "results": [
            {
              "type": "i32",
              "capture": "restored"
            }
          ]
        },
        {
          "type": "function.invoke",
          "description": "allocate 4 bytes",
          "function": "malloc",
          "params": [
            {
              "type": "i32",
              "value": "4"
            }
          ],
          "results": [
            {
              "type": "i32",
              "capture": "restored_len_ptr"
            }
          ]
        },
        {
          "type": "memory.write",
          "memory": "memory",
          "offset": {
            "var": "input"
          },
          "bytes": {
            "encoding": "utf8",
            "value": "WebAssembly corpus compression compression compression!"
          }
        },
        {
          "type": "function.invoke",
          "function": "base64_encode",
          "params": [
            {
              "type": "i32",
              "var": "input"
            },
            {
              "type": "i32",
              "value": "55"
            },
            {
              "type": "i32",
              "var": "encoded"
            },
            {
              "type": "i32",
              "var": "encoded_len_ptr"
            },
            {
              "type": "i32",
              "value": "8"
            }
          ],
          "results": []
        },
        {
          "type": "memory.read",
          "memory": "memory",
          "offset": {
            "var": "encoded_len_ptr"
          },
          "capture": {
            "type": "i32",
            "capture": "encoded_len"
          }
        },
        {
          "type": "memory.read",
          "memory": "memory",
          "offset": {
            "var": "encoded"
          },
          "assert": {
            "type": "bytes",
            "bytes": {
              "encoding": "utf8",
              "value": "V2ViQXNzZW1ibHkgY29ycHVzIGNvbXByZXNzaW9uIGNvbXByZXNzaW9uIGNvbXByZXNzaW9uIQ=="
            }
          }
        },
        {
          "type": "function.invoke",
          "function": "base64_decode",
          "params": [
            {
              "type": "i32",
              "var": "encoded"
            },
            {
              "type": "i32",
              "var": "encoded_len"
            },
            {
              "type": "i32",
              "var": "restored"
            },
            {
              "type": "i32",
              "var": "restored_len_ptr"
            },
            {
              "type": "i32",
              "value": "8"
            }
          ],
          "results": [
            {
              "type": "i32",
              "value": "1"
            }
          ]
        },
        {
          "type": "memory.read",
          "memory": "memory",
          "offset": {
            "var": "restored_len_ptr"
          },
          "assert": {
            "type": "value",
            "value": {
              "type": "i32",
              "value": "55"
            }
          }
        },
        {
          "type": "memory.read",
          "memory": "memory",
          "offset": {
            "var": "restored"
          },
          "assert": {
            "type": "bytes",
            "bytes": {
              "encoding": "utf8",
              "value": "WebAssembly corpus compression compression compression!"
            }
          }
        }
      ]
    }
  ],
  "sha256": "f01f8bc0fd8578baf52aea70b1cc92e0d195f5d274162897b1c2c723600b63da",
  "source": {
    "contributor": "human",
    "language": "c",
    "path": "lib/lib.c",
    "url": "https://github.com/aklomp/base64/blob/bf058e571ac5002b75b03fed38e33ed4e8d45eff/lib/lib.c",
    "description": "libbase64 streaming Base64 encoder and decoder. Compiled from the upstream project's human-authored source at commit bf058e571ac5002b75b03fed38e33ed4e8d45eff."
  },
  "toolchain": {
    "name": "Zig/LLVM",
    "version": "zig 0.16.0; wasm-opt version 131",
    "command": "zig cc -target wasm32-wasi -O2 -g0 -mtail-call lib/lib.c ...; ./scripts/prepare"
  },
  "description": "libbase64 streaming Base64 encoder and decoder.",
  "notes": "The fixture contains no generated workload or wrapper program: it is the upstream command/test source or library implementation itself. The metadata test drives the project's public API with representative data. Build-only configuration selects WASI-compatible facilities and does not replace project behavior."
}

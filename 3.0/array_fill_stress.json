{
  "$schema": "../schema/fixture.schema.json",
  "name": "array_fill_stress",
  "path": "array_fill_stress.wasm",
  "wat": {
    "status": "present",
    "path": "array_fill_stress.wat"
  },
  "features": [
    "gc",
    "reference-types"
  ],
  "exports": [
    {
      "name": "bench_i8",
      "kind": "function",
      "type": "(func (param i32 i32 i32) (result i32))"
    },
    {
      "name": "bench_i16",
      "kind": "function",
      "type": "(func (param i32 i32 i32) (result i32))"
    },
    {
      "name": "bench_i32",
      "kind": "function",
      "type": "(func (param i32 i32 i32) (result i32))"
    },
    {
      "name": "bench_i64",
      "kind": "function",
      "type": "(func (param i32 i32 i64) (result i64))"
    },
    {
      "name": "bench_ref",
      "kind": "function",
      "type": "(func (param i32 i32) (result i32))"
    }
  ],
  "tests": [
    {
      "description": "repeated non-zero i8 array.fill",
      "steps": [
        {
          "type": "function.invoke",
          "function": "bench_i8",
          "params": [
            { "type": "i32", "value": "10000" },
            { "type": "i32", "value": "65536" },
            { "type": "i32", "value": "43981" }
          ],
          "results": [
            { "type": "i32", "value": "205" }
          ]
        }
      ]
    },
    {
      "description": "repeated non-zero i16 array.fill",
      "steps": [
        {
          "type": "function.invoke",
          "function": "bench_i16",
          "params": [
            { "type": "i32", "value": "10000" },
            { "type": "i32", "value": "32768" },
            { "type": "i32", "value": "43981" }
          ],
          "results": [
            { "type": "i32", "value": "43981" }
          ]
        }
      ]
    },
    {
      "description": "repeated non-zero i32 array.fill",
      "steps": [
        {
          "type": "function.invoke",
          "function": "bench_i32",
          "params": [
            { "type": "i32", "value": "10000" },
            { "type": "i32", "value": "16384" },
            { "type": "i32", "value": "305419896" }
          ],
          "results": [
            { "type": "i32", "value": "305419896" }
          ]
        }
      ]
    },
    {
      "description": "repeated non-zero i64 array.fill",
      "steps": [
        {
          "type": "function.invoke",

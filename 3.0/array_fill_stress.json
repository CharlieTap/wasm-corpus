          "params": [
            { "type": "i32", "value": "10000" },
            { "type": "i32", "value": "8192" },
            { "type": "i64", "value": "81985529216486895" }
          ],
          "results": [
            { "type": "i64", "value": "81985529216486895" }
          ]
        }
      ]
    },
    {
      "description": "repeated non-null reference array.fill",
      "steps": [
        {
          "type": "function.invoke",
          "function": "bench_ref",
          "params": [
            { "type": "i32", "value": "10000" },
            { "type": "i32", "value": "16384" }

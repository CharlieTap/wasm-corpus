  },
  "toolchain": {
    "name": "Binaryen",
    "version": "wasm-opt version 125",
    "command": "./scripts/prepare"
  },
  "description": "Internally amplified non-zero array.fill operations across scalar and reference storage widths.",
  "tags": [
    "benchmark",
    "duration-long",
    "feature-gc",
    "feature-reference-types",

  "tests": [
    {
      "description": "compress and decode repeated text through heatshrink's streaming state machines",
      "steps": [
        {
          "type": "function.invoke",
          "function": "_initialize",
          "params": [],
          "results": []
        },
        {
          "type": "function.invoke",
          "description": "allocate 55 bytes",
          "function": "malloc",
          "params": [
            {
              "type": "i32",
              "value": "55"
            }
          ],
          "results": [
            {
              "type": "i32",
              "capture": "input"
            }
          ]
        },
        {
          "type": "function.invoke",
          "description": "allocate 256 bytes",
          "function": "malloc",
          "params": [
            {
              "type": "i32",
              "value": "256"
            }
          ],
          "results": [
            {
              "type": "i32",
              "capture": "output"
            }
          ]
        },
        {
          "type": "function.invoke",
          "description": "allocate 4 bytes",
          "function": "malloc",
          "params": [
            {
              "type": "i32",
              "value": "4"
            }
          ],
          "results": [
            {
              "type": "i32",
              "capture": "count"
            }
          ]
        },
        {
          "type": "memory.write",
          "memory": "memory",
          "offset": {
            "var": "input"
          },
          "bytes": {
            "encoding": "utf8",
            "value": "WebAssembly corpus compression compression compression!"
          }
        },
        {
          "type": "function.invoke",
          "function": "heatshrink_encoder_alloc",
          "params": [
            {
              "type": "i32",
              "value": "8"
            },
            {
              "type": "i32",
              "value": "4"
            }
          ],
          "results": [
            {
              "type": "i32",
              "capture": "encoder"
            }
          ]
        },
        {
          "type": "function.invoke",
          "function": "heatshrink_encoder_sink",
          "params": [
            {
              "type": "i32",
              "var": "encoder"
            },
            {
              "type": "i32",
              "var": "input"
            },
            {
              "type": "i32",
              "value": "55"
            },
            {
              "type": "i32",
              "var": "count"
            }
          ],
          "results": [
            {
              "type": "i32",
              "value": "0"
            }
          ]
        },
        {
          "type": "memory.read",
          "memory": "memory",
          "offset": {
            "var": "count"
          },
          "assert": {
            "type": "value",
            "value": {
              "type": "i32",
              "value": "55"
            }
          }
        },
        {
          "type": "function.invoke",
          "function": "heatshrink_encoder_finish",
          "params": [
            {
              "type": "i32",
              "var": "encoder"
            }
          ],
          "results": [
            {
              "type": "i32"
            }
          ]
        },
        {
          "type": "function.invoke",
          "function": "heatshrink_encoder_poll",
          "params": [
            {
              "type": "i32",
              "var": "encoder"
            },
            {
              "type": "i32",
              "var": "output"
            },
            {
              "type": "i32",
              "value": "256"
            },
            {
              "type": "i32",
              "var": "count"
            }
          ],
          "results": [
            {
              "type": "i32"
            }
          ]
        },
        {
          "type": "memory.read",

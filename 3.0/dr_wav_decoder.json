{
  "$schema": "../schema/fixture.schema.json",
  "name": "dr_wav_decoder",
  "path": "dr_wav_decoder.wasm",
  "wat": {
    "status": "present",
    "path": "dr_wav_decoder.wat"
  },
  "features": [
    "bulk-memory",
    "saturated-float-to-int",
    "tail-call"
  ],
  "tags": [
    "domain-audio",
    "domain-parsing",
    "duration-short",
    "size-medium"
  ],
  "exports": [
    {
      "name": "memory",
      "kind": "memory",
      "type": "(memory 257)"
    },
    {
      "name": "_initialize",
      "kind": "function",
      "type": "(func)"
    },
    {
      "name": "malloc",
      "kind": "function",
      "type": "(func (param i32) (result i32))"
    },
    {
      "name": "free",
      "kind": "function",
      "type": "(func (param i32))"
    },
    {
      "name": "drwav_init_memory",
      "kind": "function",
      "type": "(func (param i32 i32 i32 i32) (result i32))"
    },
    {
      "name": "drwav_uninit",
      "kind": "function",
      "type": "(func (param i32) (result i32))"
    },
    {
      "name": "drwav_free",
      "kind": "function",
      "type": "(func (param i32 i32))"
    },
    {
      "name": "drwav_read_pcm_frames_s16",
      "kind": "function",
      "type": "(func (param i32 i64 i32) (result i64))"
    },
    {
      "name": "drwav_open_memory_and_read_pcm_frames_s16",
      "kind": "function",
      "type": "(func (param i32 i32 i32 i32 i32 i32) (result i32))"
    }
  ],
  "tests": [
    {
      "description": "decode a complete in-memory PCM WAV file",
      "steps": [
        {
          "type": "function.invoke",
          "function": "_initialize",
          "params": [],
          "results": []
        },
        {
          "type": "function.invoke",
          "description": "allocate 52 bytes",
          "function": "malloc",
          "params": [
            {
              "type": "i32",
              "value": "52"
            }
          ],
          "results": [
            {
              "type": "i32",
              "capture": "wav"
            }
          ]
        },
        {
          "type": "function.invoke",
          "description": "allocate 4 bytes",
          "function": "malloc",
          "params": [
            {
              "type": "i32",
              "value": "4"
            }
          ],
          "results": [
            {
              "type": "i32",
              "capture": "channels"
            }
          ]
        },
        {
          "type": "function.invoke",
          "description": "allocate 4 bytes",
          "function": "malloc",
          "params": [
            {
              "type": "i32",
              "value": "4"
            }
          ],
          "results": [
            {
              "type": "i32",
              "capture": "rate"
            }
          ]
        },
        {
          "type": "function.invoke",
          "description": "allocate 8 bytes",
          "function": "malloc",
          "params": [
            {
              "type": "i32",
              "value": "8"
            }
          ],
          "results": [
            {
              "type": "i32",
              "capture": "frames"
            }
          ]
        },
        {
          "type": "memory.write",
          "memory": "memory",
          "offset": {
            "var": "wav"
          },
          "bytes": {
            "encoding": "base64",
            "value": "UklGRiwAAABXQVZFZm10IBAAAAABAAEAQB8AAIA+AAACABAAZGF0YQgAAAAAgBj86AP/fw=="
          }
        },
        {
          "type": "function.invoke",
          "function": "drwav_open_memory_and_read_pcm_frames_s16",
          "params": [
            {
              "type": "i32",
              "var": "wav"
            },
            {
              "type": "i32",
              "value": "52"
            },
            {
              "type": "i32",
              "var": "channels"
            },
            {
              "type": "i32",
              "var": "rate"
            },
            {
              "type": "i32",
              "var": "frames"
            },
            {
              "type": "i32",
              "value": "0"
            }
          ],
          "results": [
            {
              "type": "i32",
              "capture": "samples"
            }
          ]
        },
        {
          "type": "memory.read",
          "memory": "memory",
          "offset": {
            "var": "channels"
          },
          "assert": {
            "type": "value",
            "value": {
              "type": "i32",
              "value": "1"
            }
          }
        },
        {
          "type": "memory.read",
          "memory": "memory",
          "offset": {
            "var": "rate"
          },
          "assert": {
            "type": "value",
            "value": {
              "type": "i32",
              "value": "8000"
            }
          }
        },
        {
          "type": "memory.read",
          "memory": "memory",
          "offset": {
            "var": "frames"
          },
          "assert": {
            "type": "value",
            "value": {
              "type": "i64",
              "value": "4"
            }
          }
        },
        {
          "type": "memory.read",
          "memory": "memory",
          "offset": {
            "var": "samples"
          },
          "assert": {
            "type": "bytes",
            "bytes": {
              "encoding": "hex",
              "value": "008018fce803ff7f"
            }
          }
        },
        {
          "type": "function.invoke",
          "function": "drwav_free",
          "params": [
            {
              "type": "i32",
              "var": "samples"
            },
            {
              "type": "i32",
              "value": "0"
            }
          ],
          "results": []
        }
      ]
    }
  ],
  "sha256": "bf8e5688f2783d4dc9e4287895b9f9228aae373d099b677245f811799f139822",
  "source": {
    "contributor": "human",
    "language": "c",
    "path": "dr_wav.h",
    "url": "https://github.com/mackron/dr_libs/blob/b55a0d9a30b91ad8901f89ecf05f76a33186c185/dr_wav.h",
    "description": "dr_wav single-file audio decoder. Compiled from the upstream project's human-authored source at commit b55a0d9a30b91ad8901f89ecf05f76a33186c185."
  },
  "toolchain": {
    "name": "Zig/LLVM",
    "version": "zig 0.16.0; wasm-opt version 131",
    "command": "zig cc -target wasm32-wasi -O2 -g0 -mtail-call dr_wav.h ...; ./scripts/prepare"
  },
  "description": "dr_wav single-file audio decoder.",
  "notes": "The fixture contains no generated workload or wrapper program: it is the upstream command/test source or library implementation itself. The metadata test drives the project's public API with representative data. Build-only configuration selects WASI-compatible facilities and does not replace project behavior."
}

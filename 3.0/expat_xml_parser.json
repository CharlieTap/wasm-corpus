  "tests": [
    {
      "description": "validate well-formed and malformed XML documents",
      "steps": [
        {
          "type": "function.invoke",
          "description": "allocate 64 bytes",
          "function": "malloc",
          "params": [
            {
              "type": "i32",
              "value": "64"
            }
          ],
          "results": [
            {
              "type": "i32",
              "capture": "valid"
            }
          ]
        },
        {
          "type": "function.invoke",
          "description": "allocate 64 bytes",
          "function": "malloc",
          "params": [
            {
              "type": "i32",
              "value": "64"
            }
          ],
          "results": [
            {
              "type": "i32",
              "capture": "invalid"
            }
          ]
        },
        {
          "type": "memory.write",
          "memory": "memory",
          "offset": {
            "var": "valid"
          },
          "bytes": {
            "encoding": "utf8",
            "value": "<root><item id=\"7\">wasm</item></root>"
          }
        },
        {
          "type": "memory.write",
          "memory": "memory",
          "offset": {
            "var": "invalid"
          },
          "bytes": {
            "encoding": "utf8",
            "value": "<root><item></root>"
          }

              "type": "i32",
              "capture": "parser1"
            }
          ]
        },
        {
          "type": "function.invoke",
          "function": "XML_Parse",
          "params": [
            {
              "type": "i32",
              "var": "parser1"
            },
            {
              "type": "i32",
              "var": "valid"
            },
            {
              "type": "i32",
              "value": "37"
            },
            {
              "type": "i32",
              "value": "1"
            }
          ],
          "results": [
            {
              "type": "i32",
              "value": "1"
            }
          ]
        },
        {
          "type": "function.invoke",

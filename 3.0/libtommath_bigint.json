  "tests": [
    {
      "description": "multiply arbitrary-precision integers and render the exact product",
      "steps": [
        {
          "type": "function.invoke",
          "description": "allocate 16 bytes",
          "function": "malloc",
          "params": [
            {
              "type": "i32",
              "value": "16"
            }
          ],
          "results": [
            {
              "type": "i32",
              "capture": "a"
            }
          ]
        },
        {
          "type": "function.invoke",
          "description": "allocate 16 bytes",
          "function": "malloc",
          "params": [
            {
              "type": "i32",
              "value": "16"
            }
          ],
          "results": [
            {
              "type": "i32",
              "capture": "b"
            }
          ]
        },
        {
          "type": "function.invoke",
          "description": "allocate 16 bytes",
          "function": "malloc",
          "params": [
            {
              "type": "i32",
              "value": "16"
            }
          ],
          "results": [
            {
              "type": "i32",
              "capture": "product"
            }
          ]
        },
        {
          "type": "function.invoke",
          "description": "allocate 32 bytes",
          "function": "malloc",
          "params": [
            {
              "type": "i32",
              "value": "32"
            }
          ],
          "results": [
            {
              "type": "i32",
              "capture": "astr"
            }
          ]
        },
        {
          "type": "function.invoke",
          "description": "allocate 32 bytes",
          "function": "malloc",
          "params": [
            {
              "type": "i32",
              "value": "32"
            }
          ],
          "results": [
            {
              "type": "i32",
              "capture": "bstr"
            }
          ]
        },
        {
          "type": "function.invoke",
          "description": "allocate 80 bytes",
          "function": "malloc",
          "params": [
            {
              "type": "i32",
              "value": "80"
            }
          ],
          "results": [
            {
              "type": "i32",
              "capture": "output"
            }
          ]
        },
        {
          "type": "function.invoke",
          "description": "allocate 8 bytes",
          "function": "malloc",
          "params": [
            {
              "type": "i32",
              "value": "8"
            }
          ],
          "results": [
            {
              "type": "i32",
              "capture": "written"
            }
          ]
        },
        {
          "type": "memory.write",
          "memory": "memory",
          "offset": {
            "var": "astr"
          },
          "bytes": {
            "encoding": "utf8",
            "value": "12345678901234567890\u0000"
          }
        },
        {
          "type": "memory.write",
          "memory": "memory",
          "offset": {
            "var": "bstr"
          },
          "bytes": {
            "encoding": "utf8",
            "value": "98765432109876543210\u0000"
          }
        },
        {
          "type": "function.invoke",
          "function": "mp_init",
          "params": [
            {
              "type": "i32",
              "var": "a"
            }
          ],
          "results": [
            {
              "type": "i32",
              "value": "0"
            }
          ]
        },
        {
          "type": "function.invoke",
          "function": "mp_init",
          "params": [
            {
              "type": "i32",
              "var": "b"
            }
          ],
          "results": [
            {
              "type": "i32",
              "value": "0"
            }
          ]
        },
        {
          "type": "function.invoke",
          "function": "mp_init",
          "params": [
            {
              "type": "i32",
              "var": "product"
            }
          ],
          "results": [
            {
              "type": "i32",
              "value": "0"
            }
          ]
        },
        {
          "type": "function.invoke",
          "function": "mp_read_radix",
          "params": [
            {
              "type": "i32",
              "var": "a"
            },
            {
              "type": "i32",
              "var": "astr"
            },
            {
              "type": "i32",
              "value": "10"
            }
          ],
          "results": [
            {
              "type": "i32",
              "value": "0"
            }
          ]
        },
        {
          "type": "function.invoke",
          "function": "mp_read_radix",
          "params": [
            {
              "type": "i32",
              "var": "b"
            },
            {
              "type": "i32",
              "var": "bstr"
            },
            {
              "type": "i32",
              "value": "10"
            }
          ],
          "results": [
            {
              "type": "i32",
              "value": "0"
            }
          ]
        },
        {
          "type": "function.invoke",
          "function": "mp_mul",
          "params": [
            {
              "type": "i32",
              "var": "a"
            },
            {
              "type": "i32",
              "var": "b"
            },
            {
              "type": "i32",
              "var": "product"
            }
          ],
          "results": [
            {
              "type": "i32",
              "value": "0"
            }
          ]
        },
        {
          "type": "function.invoke",
          "function": "mp_to_radix",
          "params": [
            {
              "type": "i32",
              "var": "product"
            },
            {
              "type": "i32",
              "var": "output"
            },
            {
              "type": "i32",
              "value": "80"
            },
            {
              "type": "i32",
              "var": "written"
            },
            {
              "type": "i32",
              "value": "10"
            }
          ],
          "results": [
            {
              "type": "i32",
              "value": "0"
            }
          ]
        },
        {
          "type": "memory.read",
          "memory": "memory",
          "offset": {
            "var": "output"
          },
          "assert": {
            "type": "bytes",
            "bytes": {
              "encoding": "utf8",
              "value": "1219326311370217952237463801111263526900\u0000"
            }
          }
        },
        {

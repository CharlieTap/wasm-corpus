#!/usr/bin/env node
"use strict";

const fs = require("fs");
const path = require("path");
const childProcess = require("child_process");
const readline = require("readline");
const { execute } = require("../runners/node");

const repoRoot = path.resolve(__dirname, "..");

function formatMs(value) {
  return Number(value).toFixed(3);
}

function fixtureMetadataPath(wasmPath) {
  const parsed = path.parse(wasmPath);
  return path.join(parsed.dir, `${parsed.name}.json`);
}

function createRequest(inputPath, options) {
  const artifactPath = path.resolve(inputPath);
  const fixturePath = fixtureMetadataPath(artifactPath);
  if (!fs.existsSync(fixturePath)) {
    throw new Error(`could not find fixture metadata ${fixturePath} for ${artifactPath}`);
  }

  return {
    protocol_version: 1,
    request_id: inputPath.split(path.sep).join("/"),
    artifact_path: artifactPath,
    fixture_path: fixturePath,
    fixture: JSON.parse(fs.readFileSync(fixturePath, "utf8")),
    options,
  };
}

function report(inputPath, response, options) {
  validateResponse(response);
  if (response.status !== "passed") {
    throw new Error(response.error?.message || `${response.runner?.name || "selected"} runner failed`);
  }

  const summary = response.summary;
  console.log(
    `Executed ${inputPath} (${summary.test_count} test${summary.test_count === 1 ? "" : "s"}, ${summary.step_count} step${summary.step_count === 1 ? "" : "s"})`,
  );
  if (options.timings) {
    const timings = response.timings_ms;
    const display = (value) => value == null ? "n/a" : `${formatMs(value)}ms`;
    console.log(
      `TIME ${summary.name} total=${display(timings.total)} compile=${display(timings.compile)} instantiate=${display(timings.instantiate)} execute=${display(timings.execute)}`,
    );
  }
}

function validateResponse(response) {
  if (!response || response.protocol_version !== 1) {
    throw new Error("runner returned an invalid protocol version");
  }
  if (typeof response.request_id !== "string" || response.request_id.length === 0) {
    throw new Error("runner response is missing a request ID");
  }
  if (
    !response.runner
    || typeof response.runner.name !== "string"
    || typeof response.runner.runtime_version !== "string"
    || !["passed", "failed"].includes(response.status)
  ) {
    throw new Error("runner returned a malformed response");
  }
  if (!Array.isArray(response.tests)) {
    throw new Error("runner response is missing test results");
  }
  if (!Object.hasOwn(response, "timings_ms")) {
    throw new Error("runner response is missing timings");
  }
  if (response.status === "passed") {
    if (
      !response.summary
      || typeof response.summary.name !== "string"
      || !Number.isInteger(response.summary.test_count)
      || !Number.isInteger(response.summary.step_count)
    ) {
      throw new Error("runner response is missing a summary");
    }
  } else if (
    !response.error
    || typeof response.error.code !== "string"
    || typeof response.error.message !== "string"
  ) {
    throw new Error("failed runner response is missing an error");
  }
}

function usesWasmtime(request) {
  const relative = path.relative(repoRoot, request.artifact_path);
  return relative.split(path.sep)[0] === "experimental";
}

class WasmtimeClient {
  constructor() {
    const configured = process.env.WASM_CORPUS_WASMTIME_RUNNER;
    const candidates = configured
      ? [path.resolve(configured)]
      : [
          path.join(repoRoot, "runners/wasmtime/target/release/wasm-corpus-wasmtime-runner"),
          path.join(repoRoot, "runners/wasmtime/target/debug/wasm-corpus-wasmtime-runner"),
        ];
    const executable = candidates.find((candidate) => fs.existsSync(candidate));
    if (!executable) {
      throw new Error(
        "Wasmtime runner is not built; run cargo build --release --locked --manifest-path runners/wasmtime/Cargo.toml",
      );
    }

    this.pending = [];
    this.stderr = "";
    this.child = childProcess.spawn(executable, [], { cwd: repoRoot, stdio: ["pipe", "pipe", "pipe"] });
    this.child.stderr.setEncoding("utf8");
    this.child.stderr.on("data", (chunk) => { this.stderr += chunk; });
    readline.createInterface({ input: this.child.stdout }).on("line", (line) => {
      const pending = this.pending.shift();
      if (!pending) return;
      try { pending.resolve(JSON.parse(line)); } catch (error) { pending.reject(new Error(`Wasmtime runner returned malformed JSON: ${error.message}`)); }
    });
    this.child.on("error", (error) => this.rejectAll(error));
    this.child.on("exit", (code, signal) => {
      if (this.pending.length > 0) {
        const detail = this.stderr.trim();
        this.rejectAll(new Error(`Wasmtime runner exited ${signal || code}${detail ? `: ${detail}` : ""}`));
      }
    });
  }

  rejectAll(error) {
    for (const pending of this.pending.splice(0)) pending.reject(error);
  }

  run(request) {
    return new Promise((resolve, reject) => {
      this.pending.push({ resolve, reject });
      this.child.stdin.write(`${JSON.stringify(request)}\n`, (error) => {
        if (error) {
          this.pending.pop();
          reject(error);
        }
      });
    }).then((response) => {
      validateResponse(response);
      if (response.request_id !== request.request_id) {
        throw new Error(`Wasmtime runner response ID ${response.request_id} does not match ${request.request_id}`);
      }
      return response;
    });
  }

  async close() {
    if (this.child.exitCode !== null) return;
    this.child.stdin.end();
    await new Promise((resolve, reject) => {
      this.child.once("exit", (code, signal) => code === 0 ? resolve() : reject(new Error(`Wasmtime runner exited ${signal || code}: ${this.stderr.trim()}`)));
      this.child.once("error", reject);
    });
  }
}

function usage() {
  process.stderr.write(`Usage: ./scripts/execute [--timings] <path/to/module.wasm> [path/to/another.wasm...]

Finds each module's colocated fixture metadata, selects its corpus runner, and
runs the declared tests.
`);
}

async function main() {
  const args = process.argv.slice(2);
  if (args.length === 0) {
    usage();
    process.exit(1);
  }

  const wasmPaths = [];
  const options = { timings: false };
  for (const arg of args) {
    if (arg === "--timings") {
      options.timings = true;
    } else {
      wasmPaths.push(arg);
    }
  }

  if (wasmPaths.length === 0) {
    usage();
    process.exit(1);
  }

  let wasmtime = null;
  try {
    for (const wasmPath of wasmPaths) {
      const request = createRequest(wasmPath, options);
      let response;
      if (usesWasmtime(request)) {
        wasmtime ||= new WasmtimeClient();
        response = await wasmtime.run(request);
      } else {
        response = await execute(request);
        if (response.request_id !== request.request_id) {
          throw new Error(`Node runner response ID ${response.request_id} does not match ${request.request_id}`);
        }
      }
      report(wasmPath, response, options);
    }
  } finally {
    if (wasmtime) await wasmtime.close();
  }
}

if (require.main === module) {
  main().catch((error) => {
    console.error(`error: ${error.message}`);
    process.exit(1);
  });
}

module.exports = { WasmtimeClient, createRequest, usesWasmtime, validateResponse };

#!/usr/bin/env node
"use strict";

const fs = require("node:fs");
const {
  ClassificationError,
  classifyWasm,
} = require("../lib/classifier.ts");
const { binaryenArgsForFeatures } = require("../lib/binaryen.ts");
const { WasmToolsError } = require("../lib/wasm-tools.ts");

const args = process.argv.slice(2);
const partial = args.includes("--partial");
const unknownOptions = args.filter((arg) => arg.startsWith("--") && arg !== "--partial");
const positional = args.filter((arg) => !arg.startsWith("--"));
const wasmPath = positional[0];

if (unknownOptions.length > 0 || positional.length !== 1) {
  console.error("Usage: ./scripts/classify [--partial] <path/to/module.wasm>");
  process.exit(1);
}

if (!fs.existsSync(wasmPath)) {
  console.error(`error: file does not exist: ${wasmPath}`);
  process.exit(1);
}

let classification;
try {
  classification = classifyWasm(wasmPath, { partial });
} catch (error) {
  if (error instanceof ClassificationError || error instanceof WasmToolsError) {
    console.error(`error: ${error.message}`);
    process.exit(1);
  }
  throw error;
}

const features = [...classification.features].sort();
process.stdout.write(
  `${JSON.stringify(
    partial
      ? {
          kind: classification.kind,
          version: classification.version,
          features,
        }
      : {
          kind: classification.kind,
          version: classification.version,
          features,
          host: classification.host,
          ...(classification.kind === "module"
            ? {
                imports: classification.imports,
                exports: classification.exports,
              }
            : { world: classification.world }),
          binaryen_args: binaryenArgsForFeatures(features),
          evidence: Object.fromEntries(
            [...classification.evidence.entries()]
              .sort(([a], [b]) => a.localeCompare(b))
              .map(([feature, item]) => [
                feature,
                [`${item.validatorFeature}: ${item.reason}`],
              ]),
          ),
        },
    null,
    2,
  )}\n`,
);

#!/usr/bin/env node
"use strict";

const crypto = require("crypto");
const fs = require("fs");
const os = require("os");
const path = require("path");
const { Binaryen } = require("../lib/binaryen.ts");
const { classifyWasm } = require("../lib/classifier.ts");
const { WasmTools } = require("../lib/wasm-tools.ts");

const repoRoot = path.resolve(__dirname, "..");
const args = process.argv.slice(2);
const maxWatDisassemblyBytes = Number.parseInt(process.env.WASM_CORPUS_MAX_WAT_DISASSEMBLY_BYTES || `${64 * 1024 * 1024}`, 10);
const maxBinaryenRoundtripPasses = Number.parseInt(process.env.WASM_CORPUS_MAX_BINARYEN_ROUNDTRIP_PASSES || "12", 10);
const MAX_WASM_BYTES = 250_000_000;
const wasmTools = new WasmTools();
const binaryen = new Binaryen();

function usage() {
  process.stderr.write(`Usage: ./scripts/prepare

Finds every .wasm or .wat file directly inside stage/, classifies each one,
uses the classified features to prepare it, then writes the
optimized .wasm, matching .wat, and fixture JSON into the correct 1.0/, 2.0/,
3.0/, or experimental/ corpus directory.
`);
}

function fail(message) {
  process.stderr.write(`error: ${message}\n`);
  process.exit(1);
}

function useTool(operation) {
  try {
    return operation();
  } catch (error) {
    fail(error instanceof Error ? error.message : String(error));
  }
}

function loadAllowedTags() {
  let value;
  try {
    value = JSON.parse(fs.readFileSync(path.join(repoRoot, "scripts", "tags.json"), "utf8"));
  } catch (error) {
    fail(`could not read scripts/tags.json: ${error.message}`);
  }
  if (!Array.isArray(value) || value.some((tag) => typeof tag !== "string")) {
    fail("scripts/tags.json must contain an array of strings");
  }
  if (new Set(value).size !== value.length || JSON.stringify(value) !== JSON.stringify([...value].sort())) {
    fail("scripts/tags.json must be sorted and contain no duplicates");
  }
  return value;
}

function sizeTag(bytes) {
  if (bytes <= 500) return "size-extra-small";
  if (bytes <= 10_000) return "size-small";
  if (bytes <= 100_000) return "size-medium";
  if (bytes <= 1_000_000) return "size-large";
  if (bytes <= MAX_WASM_BYTES) return "size-extra-large";
  fail(`binary is ${bytes} bytes; corpus binaries may not exceed ${MAX_WASM_BYTES} bytes`);
}

function inferredTags({ hostTags, wasmBytes, existingTags }) {
  const tags = (existingTags || []).filter((tag) => (
    !tag.startsWith("size-") &&
    !tag.startsWith("host-wasi-preview")
  ));

  tags.push(...(hostTags || []));
  tags.push(sizeTag(wasmBytes));

  return [...new Set(tags)].sort();
}

function toPosix(relativePath) {
  return relativePath.split(path.sep).join("/");
}

function relativeFromRepo(filePath) {
  return toPosix(path.relative(repoRoot, filePath));
}

function sha256(filePath) {
  const hash = crypto.createHash("sha256");
  const fd = fs.openSync(filePath, "r");
  const buffer = Buffer.allocUnsafe(1024 * 1024);

  try {
    let bytesRead = 0;
    while ((bytesRead = fs.readSync(fd, buffer, 0, buffer.length, null)) > 0) {
      hash.update(bytesRead === buffer.length ? buffer : buffer.subarray(0, bytesRead));
    }
  } finally {
    fs.closeSync(fd);
  }

  return hash.digest("hex");
}

function binaryenVersion() {
  return useTool(() => binaryen.version());
}

function wasmToolsVersion() {
  return useTool(() => wasmTools.version());
}

function filesEqual(left, right) {
  if (left === right) return true;

  const leftStat = fs.statSync(left);
  const rightStat = fs.statSync(right);
  if (leftStat.size !== rightStat.size) return false;
  if (leftStat.dev === rightStat.dev && leftStat.ino === rightStat.ino) return true;

  const leftBuffer = fs.readFileSync(left);
  const fd = fs.openSync(right, "r");
  const rightBuffer = Buffer.allocUnsafe(1024 * 1024);
  let offset = 0;

  try {
    let bytesRead = 0;
    while ((bytesRead = fs.readSync(fd, rightBuffer, 0, rightBuffer.length, null)) > 0) {
      const leftChunk = leftBuffer.subarray(offset, offset + bytesRead);
      const rightChunk = rightBuffer.subarray(0, bytesRead);
      if (!leftChunk.equals(rightChunk)) return false;
      offset += bytesRead;
    }
  } finally {
    fs.closeSync(fd);
  }

  return offset === leftBuffer.length;
}

function prepareBinary(input, output, outputWat, features, tmpdir) {
  const strippedInput = path.join(tmpdir, "stripped-input.wasm");
  stripWasmCustomSections(input, strippedInput);
  let current = strippedInput;

  for (let pass = 1; pass <= maxBinaryenRoundtripPasses; pass += 1) {
    const candidate = path.join(tmpdir, `candidate-${pass}.wasm`);
    const candidateWat = path.join(tmpdir, `candidate-${pass}.wat`);
    const readableWat = path.join(tmpdir, `readable-${pass}.wat`);
    const roundtrip = path.join(tmpdir, `roundtrip-${pass}.wasm`);
    const strippedRoundtrip = path.join(tmpdir, `roundtrip-stripped-${pass}.wasm`);
    const checked = path.join(tmpdir, `checked-${pass}.wasm`);

    useTool(() => binaryen.optimize({
      inputPath: current,
      outputPath: candidate,
      features,
      optimizationLevel: "O1",
    }));
    useTool(() => binaryen.disassemble({
      inputPath: candidate,
      outputPath: candidateWat,
      features,
    }));
    useTool(() => binaryen.assemble({
      inputPath: candidateWat,
      outputPath: roundtrip,
      features,
    }));
    stripWasmCustomSections(roundtrip, strippedRoundtrip);
    useTool(() => binaryen.optimize({
      inputPath: strippedRoundtrip,
      outputPath: checked,
      features,
      optimizationLevel: "O1",
    }));

    let prepared = candidate;
    if (filesEqual(checked, current)) {
      prepared = current;
    }

    if (prepared === current || filesEqual(candidate, checked)) {
      useTool(() => wasmTools.print(prepared, readableWat));
      const watSize = fs.statSync(readableWat).size;
      if (watSize > maxWatDisassemblyBytes) {
        fs.copyFileSync(prepared, output);
        fs.rmSync(outputWat, { force: true });
        return {
          status: "too_large_for_corpus",
          generated_size: watSize,
          limit: maxWatDisassemblyBytes,
          tool: "wasm-tools print",
        };
      }
      fs.copyFileSync(prepared, output);
      fs.copyFileSync(readableWat, outputWat);
      return {
        status: "present",
        path: path.basename(outputWat),
      };
    }

    current = checked;
  }

  fail(`Binaryen output did not stabilize after ${maxBinaryenRoundtripPasses} passes`);
}

function prepareComponent(input, output, outputWat) {
  stripWasmCustomSections(input, output);
  const initialValidation = useTool(() => wasmTools.validate(output, "all"));
  if (!initialValidation.valid) {
    fail(`wasm-tools could not validate ${relativeFromRepo(output)}${initialValidation.diagnostic ? `\n${initialValidation.diagnostic}` : ""}`);
  }
  useTool(() => wasmTools.print(output, outputWat));
  const watSize = fs.statSync(outputWat).size;
  if (watSize > maxWatDisassemblyBytes) {
    fs.rmSync(outputWat, { force: true });
    return {
      status: "too_large_for_corpus",
      generated_size: watSize,
      limit: maxWatDisassemblyBytes,
      tool: "wasm-tools print",
    };
  }
  // Component binaries can contain custom sections nested inside core modules.
  // `wasm-tools strip` only removes sections at the outer level, while the
  // readable text format intentionally omits nested custom sections. Reparse
  // the printed component so the committed binary and WAT are canonical peers.
  useTool(() => wasmTools.parse(outputWat, output));
  const finalValidation = useTool(() => wasmTools.validate(output, "all"));
  if (!finalValidation.valid) {
    fail(`wasm-tools could not validate reparsed ${relativeFromRepo(output)}${finalValidation.diagnostic ? `\n${finalValidation.diagnostic}` : ""}`);
  }
  return {
    status: "present",
    path: path.basename(outputWat),
  };
}

function stripWasmCustomSections(input, output) {
  useTool(() => wasmTools.stripCustomSections(input, output));
}

function classify(wasmPath, options = {}) {
  return useTool(() => classifyWasm(wasmPath, { wasmTools, ...options }));
}

function compileWat(stagedWat, outputWasm) {
  useTool(() => wasmTools.parse(stagedWat, outputWasm));
}

function readExistingJson(jsonPath) {
  if (!fs.existsSync(jsonPath)) return null;

  try {
    return JSON.parse(fs.readFileSync(jsonPath, "utf8"));
  } catch (error) {
    fail(`could not read existing fixture metadata ${relativeFromRepo(jsonPath)}: ${error.message}`);
  }
}

function mergeImports(inferred, existing) {
  if (inferred.length === 0) return existing || [];

  return inferred.map((item) => {
    const previous = (existing || []).find(
      (candidate) =>
        candidate.module === item.module &&
        candidate.name === item.name &&
        candidate.kind === item.kind,
    );
    const merged = { ...previous, ...item };
    if (previous && Object.hasOwn(previous, "stub")) {
      merged.stub = previous.stub;
    }
    return merged;
  });
}

function mergeExports(inferred, existing) {
  if (inferred.length === 0) return existing || [];

  return inferred.map((item) => {
    const previous = (existing || []).find(
      (candidate) => candidate.name === item.name && candidate.kind === item.kind,
    );
    return { ...previous, ...item };
  });
}

function scaffoldMetadata({ wasmPath, wat, jsonPath, classification }) {
  const parsed = path.parse(wasmPath);
  const existing = readExistingJson(jsonPath);
  const previous = existing || {};
  const moduleShape = classification.kind === "module"
    ? classification
    : { imports: [], exports: [] };
  const schemaPath = toPosix(path.relative(parsed.dir, path.join(repoRoot, "schema", "fixture.schema.json")));
  const command = "./scripts/prepare";
  const imports = mergeImports(moduleShape.imports, previous.imports);
  const exports = mergeExports(moduleShape.exports, previous.exports);
  const source = previous.source || {
    contributor: "TODO: human or ai",
    language: "TODO: source language",
  };
  const digest = sha256(wasmPath);
  const tags = inferredTags({
    hostTags: classification.host === null
      ? []
      : [`host-wasi-${classification.host}`],
    wasmBytes: fs.statSync(wasmPath).size,
    existingTags: previous.tags,
  });
  const allowedTags = loadAllowedTags();
  const unknownTags = tags.filter((tag) => !allowedTags.includes(tag));
  if (unknownTags.length > 0) {
    fail(`${relativeFromRepo(jsonPath)} contains tags not registered in scripts/tags.json: ${unknownTags.join(", ")}`);
  }
  const assertionFromExpected = (expected) => {
    if (!expected) return {};
    if (expected.returns) return { results: expected.returns };
    if (expected.trap) return { trap: expected.trap };
    return {};
  };
  const tests = previous.tests || (previous.invocations || []).map((invocation) => {
    const { name, expected, function: functionExport, ...rest } = invocation;
    return {
      ...(name ? { description: name } : {}),
      steps: [
        {
          type: "function.invoke",
          function: functionExport,
          ...(rest.args ? { params: rest.args } : {}),
          ...Object.fromEntries(Object.entries(rest).filter(([key]) => key !== "args")),
          ...assertionFromExpected(expected),
        },
      ],
    };
  });

  const metadata = {
    $schema: previous.$schema || schemaPath,
    name: parsed.name,
    ...(previous.description ? { description: previous.description } : {}),
    path: path.basename(wasmPath),
    wat,
    features: [...classification.features].sort(),
    ...(tags.length > 0 ? { tags } : {}),
    ...(imports.length > 0 || previous.imports ? { imports } : {}),
    ...(exports.length > 0 || previous.exports ? { exports } : {}),
    tests,
    sha256: digest,
    source,
    ...(previous.toolchain || !existing
      ? {
          toolchain: previous.toolchain || {
            name: classification.kind === "component" ? "wasm-tools" : "Binaryen",
            version: classification.kind === "component" ? wasmToolsVersion() : binaryenVersion(),
            command,
          },
        }
      : {}),
    ...(previous.notes ? { notes: previous.notes } : {}),
  };

  const knownKeys = new Set(Object.keys(metadata));
  for (const [key, value] of Object.entries(previous)) {
    if (key === "invocations") continue;
    if (!knownKeys.has(key)) {
      metadata[key] = value;
    }
  }

  fs.writeFileSync(jsonPath, `${JSON.stringify(metadata, null, 2)}\n`);
}

if (args.length > 0) {
  usage();
  fail("prepare reads stage/*.wasm and stage/*.wat automatically; move candidate modules into stage/ and run ./scripts/prepare");
}

const stageDir = path.join(repoRoot, "stage");
if (!fs.existsSync(stageDir)) {
  fail("stage/ does not exist; create it and place .wasm or .wat files there");
}

const stagedEntries = fs
  .readdirSync(stageDir)
  .filter((entry) => entry.endsWith(".wasm") || entry.endsWith(".wat"))
  .sort();

const stagedBasenames = new Set();
for (const entry of stagedEntries) {
  const basename = path.parse(entry).name;
  if (stagedBasenames.has(basename)) {
    fail(`stage/ contains multiple candidate sources named ${basename}; keep either ${basename}.wasm or ${basename}.wat`);
  }
  stagedBasenames.add(basename);
}

args.push(...stagedEntries.map((entry) => path.join("stage", entry)));

if (args.length === 0) {
  process.stdout.write("No staged wasm or wat files found. Place candidate modules in stage/ and run ./scripts/prepare.\n");
  process.exit(0);
}

wasmToolsVersion();
binaryenVersion();

const tmpdir = fs.mkdtempSync(path.join(os.tmpdir(), "wasm-corpus-prepare."));
const preparedWasmPaths = [];
try {
  for (const input of args) {
    const staged = path.resolve(input);
    const stagedRelative = relativeFromRepo(staged);
    const parsed = path.parse(staged);

    if (!staged.endsWith(".wasm") && !staged.endsWith(".wat")) {
      fail(`expected a .wasm or .wat file, got: ${input}`);
    }

    if (!fs.existsSync(staged)) {
      fail(`file does not exist: ${input}`);
    }

    if (!stagedRelative.startsWith("stage/") || stagedRelative.split("/").length !== 2) {
      fail(`prepare inputs must be .wasm or .wat files directly inside stage/, got: ${input}`);
    }

    const work = fs.mkdtempSync(path.join(tmpdir, `${parsed.name}.`));
    const sourceWasm = staged.endsWith(".wat") ? path.join(work, "source.wasm") : staged;
    if (staged.endsWith(".wat")) {
      compileWat(staged, sourceWasm);
    }

    const initialClassification = classify(sourceWasm, { partial: true });
    const isComponent = initialClassification.kind === "component";
    if (!initialClassification.version && !isComponent) {
      fail(`${stagedRelative} uses features newer than the supported 1.0/2.0/3.0 corpus directories`);
    }

    const prepared = path.join(work, "prepared.wasm");
    const watTmp = path.join(work, "module.wat");
    const watMetadata = isComponent
      ? prepareComponent(sourceWasm, prepared, watTmp)
      : prepareBinary(sourceWasm, prepared, watTmp, initialClassification.features, work);
    const preparedSize = fs.statSync(prepared).size;
    if (preparedSize > MAX_WASM_BYTES) {
      fail(`${stagedRelative} prepares to ${preparedSize} bytes; corpus binaries may not exceed ${MAX_WASM_BYTES} bytes`);
    }

    const finalClassification = classify(prepared);
    const finalIsComponent = finalClassification.kind === "component";
    if (!finalClassification.version && !finalIsComponent) {
      fail(`${stagedRelative} prepared output uses features newer than the supported 1.0/2.0/3.0 corpus directories`);
    }

    const targetDir = path.join(repoRoot, finalIsComponent ? "experimental" : finalClassification.version);
    fs.mkdirSync(targetDir, { recursive: true });

    const wasm = path.join(targetDir, `${parsed.name}.wasm`);
    const wat = path.join(targetDir, `${parsed.name}.wat`);
    const json = path.join(targetDir, `${parsed.name}.json`);

    fs.renameSync(prepared, wasm);
    if (watMetadata.status === "present") {
      fs.renameSync(watTmp, wat);
      watMetadata.path = path.basename(wat);
    } else {
      fs.rmSync(wat, { force: true });
    }
    scaffoldMetadata({
      wasmPath: wasm,
      wat: watMetadata,
      jsonPath: json,
      classification: finalClassification,
    });
    fs.rmSync(staged, { force: true });

    process.stdout.write(`Prepared ${stagedRelative}\n`);
    process.stdout.write(`Wrote ${relativeFromRepo(wasm)}\n`);
    if (watMetadata.status === "present") {
      process.stdout.write(`Wrote ${relativeFromRepo(wat)}\n`);
    } else {
      process.stdout.write(`Skipped ${relativeFromRepo(wat)} (${watMetadata.tool} generated ${watMetadata.generated_size} bytes; limit ${watMetadata.limit})\n`);
    }
    process.stdout.write(`Wrote ${relativeFromRepo(json)}\n`);
    process.stdout.write(`Removed ${stagedRelative}\n`);
    process.stdout.write(`${sha256(wasm)}  ${relativeFromRepo(wasm)}\n`);
    preparedWasmPaths.push(relativeFromRepo(wasm));
  }

  if (preparedWasmPaths.length > 0) {
    const paths = preparedWasmPaths.join(" ");
    process.stdout.write("\nNext steps:\n");
    process.stdout.write("1. Complete the generated JSON metadata.\n");
    process.stdout.write(`2. Run with Node 24: ./scripts/execute ${paths}\n`);
    process.stdout.write("3. Assign a duration tag using docs/tagging.md.\n");
    process.stdout.write(`4. Run: ./scripts/validate ${paths}\n`);
  }
} finally {
  fs.rmSync(tmpdir, { recursive: true, force: true });
}

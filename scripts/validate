#!/usr/bin/env node
"use strict";

const crypto = require("crypto");
const fs = require("fs");
const os = require("os");
const path = require("path");
const { spawnSync } = require("child_process");
const { Binaryen, binaryenArgsForFeatures } = require("../lib/binaryen.ts");
const { classifyWasm } = require("../lib/classifier.ts");
const { detectWasiPreview } = require("../lib/wasi-host-detector.ts");
const { WasmTools } = require("../lib/wasm-tools.ts");

const repoRoot = path.resolve(__dirname, "..");
const args = process.argv.slice(2);
const maxWatDisassemblyBytes = Number.parseInt(process.env.WASM_CORPUS_MAX_WAT_DISASSEMBLY_BYTES || `${64 * 1024 * 1024}`, 10);
const MAX_WASM_BYTES = 250_000_000;
const wasmTools = new WasmTools();
const binaryenClient = new Binaryen();

function usage() {
  process.stderr.write(`Usage: ./scripts/validate <path/to/module.wasm> [path/to/another.wasm...]

Validates corpus fixture metadata against the JSON Schema, classifies each
module for version directory and feature metadata, runs
canonical tag invariants, runs Binaryen over each wasm file and its sibling wat
file, then checks that the binary does not shrink suspiciously after
optimization.
`);
}

function warn(message) {
  process.stderr.write(`warning: ${message}\n`);
}

function fail(message) {
  process.stderr.write(`error: ${message}\n`);
  process.exit(1);
}

function run(command, commandArgs, options = {}) {
  return spawnSync(command, commandArgs, {
    cwd: repoRoot,
    encoding: "utf8",
    maxBuffer: 64 * 1024 * 1024,
    ...options,
  });
}

function commandExists(command) {
  return run("sh", ["-c", `command -v "$1" >/dev/null 2>&1`, "sh", command]).status === 0;
}

function toPosix(relativePath) {
  return relativePath.split(path.sep).join("/");
}

function relativeFromRepo(filePath) {
  return toPosix(path.relative(repoRoot, path.resolve(filePath)));
}

function prepareAdvice(wasmPath) {
  return `copy or move ${relativeFromRepo(wasmPath)} into stage/ and run ./scripts/prepare`;
}

function fileSize(filePath) {
  return fs.statSync(filePath).size;
}

function percentReduction(original, optimized) {
  if (original === 0 || optimized >= original) return 0;
  return Math.floor(((original - optimized) * 100) / original);
}

function sha256(filePath) {
  const hash = crypto.createHash("sha256");
  const fd = fs.openSync(filePath, "r");
  const buffer = Buffer.allocUnsafe(1024 * 1024);

  try {
    let bytesRead = 0;
    while ((bytesRead = fs.readSync(fd, buffer, 0, buffer.length, null)) > 0) {
      hash.update(bytesRead === buffer.length ? buffer : buffer.subarray(0, bytesRead));
    }
  } finally {
    fs.closeSync(fd);
  }

  return hash.digest("hex");
}

function filesEqual(left, right) {
  if (left === right) return true;

  const leftStat = fs.statSync(left);
  const rightStat = fs.statSync(right);
  if (leftStat.size !== rightStat.size) return false;
  if (leftStat.dev === rightStat.dev && leftStat.ino === rightStat.ino) return true;

  const leftBuffer = fs.readFileSync(left);
  const fd = fs.openSync(right, "r");
  const rightBuffer = Buffer.allocUnsafe(1024 * 1024);
  let offset = 0;

  try {
    let bytesRead = 0;
    while ((bytesRead = fs.readSync(fd, rightBuffer, 0, rightBuffer.length, null)) > 0) {
      const leftChunk = leftBuffer.subarray(offset, offset + bytesRead);
      const rightChunk = rightBuffer.subarray(0, bytesRead);
      if (!leftChunk.equals(rightChunk)) return false;
      offset += bytesRead;
    }
  } finally {
    fs.closeSync(fd);
  }

  return offset === leftBuffer.length;
}

function binaryenVersion() {
  const output = binaryenClient.version();
  const match = output.match(/version\s+([0-9]+)/);
  return match ? match[1] : output;
}

function loadAllowedTags() {
  let tags;
  try {
    tags = JSON.parse(fs.readFileSync(path.join(repoRoot, "scripts", "tags.json"), "utf8"));
  } catch (error) {
    throw new Error(`could not read scripts/tags.json: ${error.message}`);
  }
  if (!Array.isArray(tags) || tags.some((tag) => typeof tag !== "string")) {
    throw new Error("scripts/tags.json must contain an array of strings");
  }
  if (new Set(tags).size !== tags.length) {
    throw new Error("scripts/tags.json must not contain duplicates");
  }
  if (JSON.stringify(tags) !== JSON.stringify([...tags].sort())) {
    throw new Error("scripts/tags.json must be sorted");
  }
  if (tags.some((tag) => !/^[a-z0-9][a-z0-9._-]*$/.test(tag))) {
    throw new Error("scripts/tags.json contains an invalid tag");
  }
  return tags;
}

function exactFamily(tags, prefix) {
  return (tags || []).filter((tag) => tag.startsWith(prefix)).sort();
}

function sameStrings(left, right) {
  return JSON.stringify([...left].sort()) === JSON.stringify([...right].sort());
}

function detectedHostTags(wasmPath, imports, classification) {
  const input = classification.kind === "component"
    ? {
        kind: "component",
        world: wasmTools.componentWorld(wasmPath),
      }
    : {
        kind: "module",
        imports: imports || [],
      };
  const preview = detectWasiPreview(input);
  return preview === null ? [] : [`host-wasi-${preview}`];
}

function sizeTag(bytes) {
  if (bytes <= 500) return "size-extra-small";
  if (bytes <= 10_000) return "size-small";
  if (bytes <= 100_000) return "size-medium";
  if (bytes <= 1_000_000) return "size-large";
  if (bytes <= MAX_WASM_BYTES) return "size-extra-large";
  throw new Error(`binary is ${bytes} bytes; corpus binaries may not exceed ${MAX_WASM_BYTES} bytes`);
}

function collectFixtureJsonFiles() {
  const fixtures = [];
  for (const dir of ["1.0", "2.0", "3.0", "experimental"]) {
    const absoluteDir = path.join(repoRoot, dir);
    if (!fs.existsSync(absoluteDir)) continue;

    for (const entry of fs.readdirSync(absoluteDir)) {
      if (entry.endsWith(".json")) {
        fixtures.push(path.join(dir, entry));
      }
    }
  }
  return fixtures.sort();
}

function validateFixtureMetadata() {
  const fixtures = collectFixtureJsonFiles();
  if (fixtures.length === 0) return;

  const result = run("npx", [
    "--yes",
    "ajv-cli@5",
    "validate",
    "--spec=draft2020",
    "-s",
    "schema/fixture.schema.json",
    ...fixtures.flatMap((fixture) => ["-d", fixture]),
  ]);

  if (result.status !== 0) {
    process.stdout.write(result.stdout || "");
    process.stderr.write(result.stderr || "");
    process.exit(result.status || 1);
  }

  process.stdout.write(result.stdout || "");
  process.stderr.write(result.stderr || "");
}

function readFixture(wasmPath) {
  const parsed = path.parse(wasmPath);
  const fixturePath = path.join(parsed.dir, `${parsed.name}.json`);

  if (!fs.existsSync(fixturePath)) {
    throw new Error(`missing matching fixture metadata: ${fixturePath}`);
  }

  try {
    return {
      path: fixturePath,
      value: JSON.parse(fs.readFileSync(fixturePath, "utf8")),
    };
  } catch (error) {
    throw new Error(`could not read fixture metadata ${fixturePath}: ${error.message}`);
  }
}

function classify(wasmPath) {
  return classifyWasm(wasmPath, { wasmTools });
}

function classifierOutput(classification) {
  return {
    version: classification.version,
    features: [...classification.features].sort(),
    binaryen_args: binaryenArgsForFeatures(classification.features),
    evidence: Object.fromEntries(
      [...classification.evidence.entries()]
        .sort(([left], [right]) => left.localeCompare(right))
        .map(([feature, item]) => [
          feature,
          [`${item.validatorFeature}: ${item.reason}`],
        ]),
    ),
  };
}

function validateFixtureForWasm(wasmPath, fixturePath, fixture) {
  const parsed = path.parse(wasmPath);
  const expectedWasm = `${parsed.name}.wasm`;

  if (fixture.path !== expectedWasm) {
    throw new Error(`${fixturePath} path must be ${expectedWasm}, got ${fixture.path}`);
  }

  if (fixture.wat.status === "present") {
    const expectedWat = `${parsed.name}.wat`;
    if (fixture.wat.path !== expectedWat) {
      throw new Error(`${fixturePath} wat.path must be ${expectedWat}, got ${fixture.wat.path}`);
    }
  } else if (fixture.wat.status === "too_large_for_corpus") {
    if (fixture.wat.generated_size <= fixture.wat.limit) {
      throw new Error(`${fixturePath} wat.generated_size must be greater than wat.limit when status is too_large_for_corpus`);
    }
  } else {
    throw new Error(`${fixturePath} wat.status must be present or too_large_for_corpus`);
  }

  if (fixture.name !== parsed.name) {
    throw new Error(`${fixturePath} name must match basename ${parsed.name}, got ${fixture.name}`);
  }

  const actualSha256 = sha256(wasmPath);
  if (fixture.sha256 !== actualSha256) {
    throw new Error(`${fixturePath} sha256 does not match ${relativeFromRepo(wasmPath)}: expected ${actualSha256}, got ${fixture.sha256}`);
  }
}

function validateTagRegistry() {
  const allowedTags = loadAllowedTags();
  return new Set(allowedTags);
}

function requireExactFamily(fixturePath, actual, expected, family) {
  if (!sameStrings(actual, expected)) {
    throw new Error(
      `${fixturePath} ${family} tags must exactly match generated metadata\n` +
      `       expected: ${expected.join(", ") || "(none)"}\n` +
      `       actual:   ${actual.join(", ") || "(none)"}`,
    );
  }
}

function validateFixtureTags(wasmPath, fixturePath, fixture, classification, allowedTags) {
  const relativeFixture = relativeFromRepo(fixturePath);
  const tags = fixture.tags || [];
  const unknown = tags.filter((tag) => !allowedTags.has(tag));
  if (unknown.length > 0) {
    throw new Error(`${relativeFixture} contains unknown tag(s): ${unknown.join(", ")}\n       consult docs/tagging.md and scripts/tags.json`);
  }
  if (JSON.stringify(tags) !== JSON.stringify([...tags].sort())) {
    throw new Error(`${relativeFixture} tags must be sorted`);
  }
  if (exactFamily(tags, "domain-").length > 3) {
    throw new Error(`${relativeFixture} may declare at most three domain tags`);
  }

  const detectedHosts = detectedHostTags(wasmPath, fixture.imports, classification);
  const actualHosts = exactFamily(tags, "host-");
  for (const host of detectedHosts) {
    if (!actualHosts.includes(host)) {
      throw new Error(`${relativeFixture} is missing detected host tag ${host}`);
    }
  }
  for (const host of actualHosts) {
    if (host.startsWith("host-wasi-preview") && !detectedHosts.includes(host)) {
      throw new Error(`${relativeFixture} declares ${host} but it was not detected in the artifact`);
    }
  }

  const expectedSize = sizeTag(fileSize(wasmPath));
  requireExactFamily(relativeFixture, exactFamily(tags, "size-"), [expectedSize], "size");

  const durations = exactFamily(tags, "duration-");
  if (durations.length !== 1) {
    throw new Error(`${relativeFixture} must declare exactly one duration tag following docs/tagging.md`);
  }
}

function validateClassifiedVersion(wasmPath, classification) {
  const relativeWasm = relativeFromRepo(wasmPath);
  const versionDir = relativeWasm.split("/")[0];

  if (versionDir === "experimental") {
    if (classification.kind !== "component") {
      throw new Error(`${relativeWasm} must be a Component Model artifact to live in experimental/`);
    }
    if (classification.version) {
      throw new Error(`${relativeWasm} classifies as stable core WebAssembly ${classification.version}, not experimental`);
    }
    return;
  }

  if (!["1.0", "2.0", "3.0"].includes(versionDir)) {
    throw new Error(`${relativeWasm} must be inside 1.0/, 2.0/, or 3.0/`);
  }

  if (!classification.version) {
    throw new Error(`${relativeWasm} uses features newer than the supported 1.0/2.0/3.0 corpus directories\n       classifier output: ${JSON.stringify(classifierOutput(classification))}`);
  }

  if (versionDir !== classification.version) {
    throw new Error(`${relativeWasm} belongs in ${classification.version}/ based on ./scripts/classify, not ${versionDir}/\n       corpus entries must use the lowest version directory that can represent the module\n       classifier output: ${JSON.stringify(classifierOutput(classification))}`);
  }
}

function validateClassifiedFeatures(wasmPath, fixture, classification) {
  const declared = new Set(fixture.features || []);
  const detected = new Set(classification.features || []);
  const missing = [...detected].filter((feature) => !declared.has(feature));
  const unexpected = [...declared].filter((feature) => !detected.has(feature));

  if (missing.length > 0 || unexpected.length > 0) {
    throw new Error(`${relativeFromRepo(wasmPath)} metadata features do not match the classifier${missing.length > 0 ? `\n       missing: ${missing.join(", ")}` : ""}${unexpected.length > 0 ? `\n       unexpected: ${unexpected.join(", ")}` : ""}\n       declared features: ${(fixture.features || []).join(", ") || "(none)"}\n       classifier output: ${JSON.stringify(classifierOutput(classification))}`);
  }
}

function optimizeWithBinaryen({ wasmPath, workDir, binaryenVersion, features }) {
  const stripped = path.join(workDir, "stripped.wasm");
  const optimized = path.join(workDir, "optimized.wasm");
  stripWasmCustomSections(wasmPath, stripped);
  try {
    binaryenClient.optimize({
      inputPath: stripped,
      outputPath: optimized,
      features,
      optimizationLevel: "O1",
    });
  } catch (error) {
    throw new Error(`Binaryen could not optimize ${relativeFromRepo(wasmPath)}\n       Binaryen version used: ${binaryenVersion}\n       ${error.message}`, { cause: error });
  }
  return optimized;
}

function validateBinaryenRoundtrip({ wasmPath, watPath, workDir, binaryenVersion, features, optimized }) {
  const disassembled = path.join(workDir, "module.wat");
  const watWasm = path.join(workDir, "wat.wasm");
  const watStripped = path.join(workDir, "wat-stripped.wasm");
  const watOptimized = path.join(workDir, "wat-optimized.wasm");

  try {
    binaryenClient.disassemble({
      inputPath: optimized,
      outputPath: disassembled,
      features,
    });
    wasmTools.parse(watPath, watWasm);
    stripWasmCustomSections(watWasm, watStripped);
    binaryenClient.optimize({
      inputPath: watStripped,
      outputPath: watOptimized,
      features,
      optimizationLevel: "O1",
    });
  } catch (error) {
    throw new Error(`could not verify the Binaryen roundtrip for ${relativeFromRepo(wasmPath)}\n       Binaryen version used: ${binaryenVersion}\n       ${error.message}`, { cause: error });
  }

  if (!filesEqual(optimized, watOptimized)) {
    throw new Error(`${relativeFromRepo(watPath)} does not roundtrip to the same optimized module as ${relativeFromRepo(wasmPath)}\n       Binaryen version used: ${binaryenVersion}\n       ${prepareAdvice(wasmPath)} to refresh both files`);
  }

}

function stripWasmCustomSections(input, output) {
  wasmTools.stripCustomSections(input, output);
}

function validateShrinkage(wasmPath, optimizedPath, binaryen) {
  const minSizeCheckBytes = Number.parseInt(process.env.WASM_CORPUS_VALIDATE_MIN_SIZE || "1024", 10);
  const maxReductionPercent = Number.parseInt(process.env.WASM_CORPUS_VALIDATE_MAX_REDUCTION_PERCENT || "20", 10);
  const maxReductionBytes = Number.parseInt(process.env.WASM_CORPUS_VALIDATE_MAX_REDUCTION_BYTES || "512", 10);

  const originalSize = fileSize(wasmPath);
  const optimizedSize = fileSize(optimizedPath);
  const reductionBytes = optimizedSize < originalSize ? originalSize - optimizedSize : 0;
  const reductionPercent = percentReduction(originalSize, optimizedSize);

  if (
    originalSize >= minSizeCheckBytes &&
    reductionBytes >= maxReductionBytes &&
    reductionPercent > maxReductionPercent
  ) {
    throw new Error(`${relativeFromRepo(wasmPath)} shrank substantially when Binaryen was applied\n       Binaryen version used: ${binaryen}\n       original size:  ${originalSize} bytes\n       optimized size: ${optimizedSize} bytes\n       reduction:      ${reductionBytes} bytes (${reductionPercent}%)\n       this usually means Binaryen has not been applied yet; ${prepareAdvice(wasmPath)}`);
  }

  return { optimizedSize, reductionBytes, reductionPercent };
}

function validateWatReadability(watPath) {
  const watSize = fileSize(watPath);
  if (watSize > maxWatDisassemblyBytes) {
    throw new Error(`${relativeFromRepo(watPath)} is too large to review as readable WAT\n       WAT size:         ${watSize} bytes\n       maximum WAT size: ${maxWatDisassemblyBytes} bytes\n       ${prepareAdvice(watPath.replace(/\.wat$/, ".wasm"))} after choosing a smaller module`);
  }

  const fd = fs.openSync(watPath, "r");
  const buffer = Buffer.alloc(Math.min(watSize, 1024 * 1024));
  try {
    fs.readSync(fd, buffer, 0, buffer.length, 0);
  } finally {
    fs.closeSync(fd);
  }
  const prefix = buffer.toString("utf8");
  if (prefix.includes("(module binary")) {
    throw new Error(`${relativeFromRepo(watPath)} uses '(module binary ...)' instead of readable WAT\n       ${prepareAdvice(watPath.replace(/\.wat$/, ".wasm"))} to regenerate a readable disassembly`);
  }
}

function validateComponent({ wasmPath, watPath, workDir }) {
  const validation = wasmTools.validate(wasmPath, "all");
  if (!validation.valid) {
    throw new Error(`wasm-tools could not validate component ${relativeFromRepo(wasmPath)}${validation.diagnostic ? `\n       ${validation.diagnostic}` : ""}`);
  }

  if (!watPath) return;
  const watWasm = path.join(workDir, "component-from-wat.wasm");
  const strippedWasm = path.join(workDir, "component-stripped.wasm");
  const strippedWatWasm = path.join(workDir, "component-from-wat-stripped.wasm");
  wasmTools.parse(watPath, watWasm);
  stripWasmCustomSections(wasmPath, strippedWasm);
  stripWasmCustomSections(watWasm, strippedWatWasm);
  if (!filesEqual(strippedWasm, strippedWatWasm)) {
    throw new Error(`${relativeFromRepo(watPath)} does not roundtrip to ${relativeFromRepo(wasmPath)}`);
  }
}

function validateOne(wasmPath, workDir, binaryenVersion, allowedTags) {
  if (!wasmPath.endsWith(".wasm")) {
    throw new Error(`expected a .wasm file, got: ${wasmPath}`);
  }

  if (!fs.existsSync(wasmPath)) {
    throw new Error(`file does not exist: ${wasmPath}`);
  }

  const { path: fixturePath, value: fixture } = readFixture(wasmPath);
  validateFixtureForWasm(wasmPath, fixturePath, fixture);

  const classification = classify(wasmPath);
  validateFixtureTags(wasmPath, fixturePath, fixture, classification, allowedTags);
  validateClassifiedVersion(wasmPath, classification);
  validateClassifiedFeatures(wasmPath, fixture, classification);

  const watPath = fixture.wat.status === "present"
    ? path.join(path.dirname(wasmPath), fixture.wat.path)
    : null;

  if (fixture.wat.status === "present") {
    if (!fs.existsSync(watPath)) {
      throw new Error(`missing matching wat file: ${watPath}\n       Binaryen version used: ${binaryenVersion}\n       ${prepareAdvice(wasmPath)} to generate it`);
    }
    validateWatReadability(watPath);
  } else {
    const siblingWat = wasmPath.replace(/\.wasm$/, ".wat");
    if (fs.existsSync(siblingWat)) {
      throw new Error(`${relativeFromRepo(siblingWat)} exists but ${relativeFromRepo(fixturePath)} marks WAT as too_large_for_corpus`);
    }
  }

  if (classification.kind === "component") {
    validateComponent({ wasmPath, watPath, workDir });
    process.stdout.write(
      `Validated ${relativeFromRepo(wasmPath)} with wasm-tools (${classification.features.size} feature(s); ${fileSize(wasmPath)} bytes)\n`,
    );
    return;
  }

  const optimized = optimizeWithBinaryen({
    wasmPath,
    workDir,
    binaryenVersion,
    features: classification.features,
  });
  if (watPath) {
    validateBinaryenRoundtrip({
      wasmPath,
      watPath,
      workDir,
      binaryenVersion,
      features: classification.features,
      optimized,
    });
  }
  const shrinkage = validateShrinkage(wasmPath, optimized, binaryenVersion);

  process.stdout.write(
    `Validated ${relativeFromRepo(wasmPath)} with Binaryen ${binaryenVersion} and classifier ${classification.version} (${classification.features.size} feature(s); optimized size ${shrinkage.optimizedSize} bytes, reduction ${shrinkage.reductionBytes} bytes / ${shrinkage.reductionPercent}%)\n`,
  );
}

if (args.length < 1) {
  usage();
  process.exit(1);
}

const missing = ["npx"].filter(
  (command) => !commandExists(command),
);

if (missing.length > 0) {
  warn("npx is required to validate corpus metadata.");
  warn(`Missing command(s): ${missing.join(" ")}`);
  process.exit(1);
}

validateFixtureMetadata();

let allowedTags;
try {
  allowedTags = validateTagRegistry();
} catch (error) {
  fail(error.message);
}

let binaryen;
try {
  wasmTools.version();
  binaryen = binaryenVersion();
} catch (error) {
  fail(error instanceof Error ? error.message : String(error));
}
const tmpdir = fs.mkdtempSync(path.join(os.tmpdir(), "wasm-corpus-validate."));
let status = 0;

try {
  args.forEach((input, index) => {
    try {
      const wasmPath = path.resolve(input);
      const workDir = path.join(tmpdir, String(index + 1));
      fs.mkdirSync(workDir, { recursive: true });
      validateOne(wasmPath, workDir, binaryen, allowedTags);
    } catch (error) {
      process.stderr.write(`error: ${error.message}\n`);
      status = 1;
    }
  });
} finally {
  fs.rmSync(tmpdir, { recursive: true, force: true });
}

process.exit(status);
